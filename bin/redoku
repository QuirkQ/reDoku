#!/bin/sh
# bin/redoku — get the rm2fb display server, the M4 decoy document + its
# watcher, and the reDoku game on and off a reMarkable 2 over SSH, without
# needing to understand the ssh/scp choreography.
#
# Works on Linux and macOS with the stock OpenSSH client. There are two
# places it runs from, and it is the same script in both. A reDoku checkout
# is one. A released kit is the other: a self-contained tree that ships
# device/install.sh, device/uninstall.sh, device/redoku-watcher.service and
# the cross-built binaries beside this file, so ~/.redoku/current/bin/redoku
# has everything a checkout would have given it and needs no checkout at
# all. 'ruby' is wanted in a checkout only, where tools/mkdecoy.rb generates
# the decoy document; a kit ships that decoy prebuilt, which is what retires
# the dependency rather than merely hiding it.
#
# Safe by design:
#   * Your ~/.ssh/config is IGNORED by default (ssh -F /dev/null), so a
#     stray "Host *" rule can't break the connection — plain password
#     auth over the USB cable just works. Have keys or aliases set up?
#     Pass --ssh-config ~/.ssh/config.
#   * Host keys are pinned in ~/.ssh/redoku_known_hosts: the first
#     connection is trusted, a later mismatch fails loudly — and your
#     real known_hosts is never touched.
#   * Binaries are verified to be 32-bit ARM ELF before anything is
#     copied, every copy (the decoy's files and the watcher unit
#     included) is size-checked, and the on-device installer rolls the
#     device back to stock if anything fails.
#   * Anything downloaded is checked against the sha256 published beside
#     it before it is unpacked, and nothing unverified is ever run or
#     installed — a check that fails leaves your kit as it was. What that
#     buys is integrity, not authenticity: the checksum ships in the same
#     release as the file it vouches for (see the README).
#   * install and uninstall ask before touching the device (or pass --yes);
#     play does not, since its only write is one binary that play alone
#     refreshes on every run by design. --dry-run always shows the plan
#     without doing it, for every command.

set -eu

REPO=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)

# Which version am I, and am I a release build? A checkout stays "dev"
# forever; tools/mkkit.sh stamps this exact line to the real tag in every
# copy of this CLI it releases (design doc §3.3). That single rewrite is
# what lets a released CLI resolve and fetch its OWN tag with no separate
# lookup (§6.1) — and it must stay byte-for-byte "KIT_VERSION=dev" here,
# because mkkit.sh finds the line to rewrite by literal match, not a marker
# comment or a template placeholder.
KIT_VERSION=dev

# The second of the two markers (design doc §5.1). KIT_VERSION answers
# "which version am I, and am I a release build?"; this one answers "are the
# artifacts sitting beside me?". Both are needed, and neither can be derived
# from the other: the curl|sh bootstrap runs a STAMPED copy of this CLI out
# of a temp directory with no kit anywhere near it — it knows its version and
# knows it has to fetch one — while those same stamped bytes running from
# ~/.redoku/current/bin/ know exactly the opposite. One marker cannot express
# both states. tools/mkkit.sh writes VERSION at the root of every kit it
# packs (§3.2); a checkout has no such file.
IN_KIT=0
[ ! -f "$REPO/VERSION" ] || IN_KIT=1

# Where the artifacts this run installs actually live. It is $REPO in a
# checkout AND inside a kit — the kit deliberately mirrors a checkout's
# build/ tree so that not one path below has to change (design doc D8) — and
# it is the downloaded tree, and only then, for a checkout-mode
# 'install --download', which unpacks into build/download/<tag>/ rather than
# into build/rm2fb/ so a release binary can never quietly become the thing
# you thought you built (§5.4).
#
# One variable, not three. §10 weighed RM2FB_DIR + GAME_BIN + DECOY_DIR
# against this and rejected them: three new variables have to be read every
# time anyone touches those code paths, where one root that is $REPO in every
# pre-existing case leaves every resolved path byte-identical to today's and
# extends D8's "no path in bin/redoku changes" property to the kit case too.
# Exactly three call sites read it: pick_artifact, find_game, build_decoy.
KIT_ROOT=$REPO

# Where releases live, derived exactly the way tools/install.sh derives it.
# The bootstrap and the CLI it hands over to must agree on this, or
# REDOKU_BASE_URL would only move half of an install — and §8's offline
# tests, which point it at a file:// fixture, would only cover half.
BASE_URL=${REDOKU_BASE_URL:-https://github.com/QuirkQ/reDoku/releases}

# The two ways to install with no network at all, named once and reused by
# every message below that has to offer them (design doc §7's failure
# catalogue). The same sentence tools/install.sh carries, so the advice
# cannot drift between the bootstrap and the CLI it hands over to.
OFFLINE_ROUTES="install another way: --artifacts DIR against binaries you already have, or, from a checkout, 'make rm2fb' to build them locally"

REMOTE_DIR=/home/root/redoku
REMOTE_GAME=$REMOTE_DIR/bin/redoku    # the game binary on the device
# $HOME is read on the very next line and in five places below, and under
# `set -u` an unset one ends the run with a bare "HOME: parameter not set" that
# names no fix. tools/install.sh goes to trouble to keep working when only
# $REDOKU_HOME is set — it has its own guard saying so, and defaults the kit
# directory from whichever of the two exists — and then hands over to this file,
# which died on $HOME regardless. So the bootstrap's promise was true of the
# bootstrap and false of the install. Checked once, here, before any of the
# five readers: this is not a state to be clever about, because the ssh
# known-hosts file and the control socket genuinely have nowhere else to live.
# printf and exit rather than die(), which is not defined until line 175 — this
# check has to run before the two assignments below it, and those are top-level
# code above the function definitions. The format is die()'s, deliberately, so
# the output is indistinguishable from every other failure in this file.
if [ -z "${HOME:-}" ]; then
  printf 'ERROR: %s\n' "\$HOME is not set, so there is nowhere to keep the pinned host key
  (~/.ssh/redoku_known_hosts) or the ssh control socket. \$REDOKU_HOME alone is
  enough to say where the KIT goes, but not where those two live. Set HOME and
  try again — 'HOME=\$(cd ~ && pwd) redoku …' does it if it is merely unexported." >&2
  exit 1
fi
KNOWN_HOSTS=$HOME/.ssh/redoku_known_hosts
CTL_PATH=$HOME/.ssh/redoku-ctl-%C

HOST=10.11.99.1
RUSER=root
SSH_CFG=            # empty = the safe default (-F /dev/null)
IDENTITY=
ARTIFACTS=
FORCE=0
PURGE=0
# --purge and --self are independent and may be combined, and they are about
# two different machines: --purge deletes /home/root/redoku on the DEVICE,
# --self deletes the kit and the PATH entry on THIS one. The two are easy to
# confuse and the consequences differ, so every message that mentions either
# says which machine it means (design doc §5.2, §5.3).
SELF=0
PLAY_SECS=          # empty = play interactively, until you stop it
PLAY_SECS_SET=0     # was --seconds given at all, distinct from its value
# Seconds a timed run's SIGTERM gets before the SIGKILL. Longer than the
# display connection's own 10 s receive timeout on purpose — see cmd_play.
KILL_GRACE=15
YES=0
DRY=0
CMD=

DOWNLOAD=0
# The kit root, and — by its mere presence — whether this run is a kit
# install at all (design doc §5.2: "--kit alone decides it"). Empty means
# checkout mode. REDOKU_HOME is the environment form of the same option, so
# the precedence is the usual one: the flag beats the variable. The
# ~/.redoku default the docs name is NOT repeated here; see resolve_kit_mode
# for why not.
KIT_DIR=${REDOKU_HOME:-}
# Was --kit given, as distinct from REDOKU_HOME being set? The "only applies
# to install" checks below restrict the OPTION, never the environment
# variable — someone with REDOKU_HOME exported must still be able to run
# 'bin/redoku status'.
KIT_DIR_SET=0
BIN_DIR=${REDOKU_BIN_DIR:-$HOME/.local/bin}
BIN_DIR_SET=0
NO_SYMLINK=0

# Set by resolve_tag / fetch_kit below; declared here because set -u makes
# reading an unset one a fatal error rather than an empty string, and
# fetch_url reads $TAG on a path where resolve_tag may not have run yet.
TAG=
FETCH_TAG=
FETCH_TREE=
FETCH_BASE=
FETCH_TMP=
FETCH_LAYOUT=
FETCH_TARGET=
SHA256_TOOL=

# Does this run want the LATEST release, or the one this CLI belongs to?
# Set to 1 by cmd_upgrade alone, and read by resolve_tag's step 2.
#
# §6.1's step 2 — "a released CLI fetches its OWN tag" — is exactly right for
# 'install': re-running a kit's own installer must not silently change which
# version is installed. It is exactly wrong for 'upgrade', whose entire job is
# to find a tag NEWER than the one this copy was stamped with; taking step 2
# there would make every upgrade from a released kit a no-op that reported
# success. So upgrade turns step 2 off and steps 1, 3 and 4 — REDOKU_VERSION,
# the redirect and the tarball's own VERSION — carry it, which is also why
# REDOKU_VERSION still pins for upgrade: step 1 is untouched.
WANT_LATEST=0

say()  { printf '==> %s\n' "$*"; }
die()  { printf 'ERROR: %s\n' "$*" >&2; exit 1; }

# How the user spells THIS CLI, in whichever of the two worlds this run is
# printing into: 'redoku' on the PATH from a kit, 'bin/redoku' from a
# checkout. Every message that tells someone to run this program again has to
# go through it, because advice that names a command the reader does not have
# is the same class of wrong advice as advice that names the wrong command
# (design doc §7's last paragraph) — and the plan and closing blocks of
# `install` used to end on 'bin/redoku status' however they were reached.
#
# It sits up here with say() and die(), rather than beside refetch_hint where
# it began, because the argument parser's "unknown argument" die is one of its
# callers and that loop is top-level code that RUNS while this file is still
# being read: a definition further down had not happened yet, and the call
# produced "cli_name: command not found" and an empty name. Measured, once,
# rather than reasoned about — which is also why nothing above this line may
# call it. Both variables it reads are set well before here.
#
# Deliberately the same condition refetch_hint uses further down, and they
# stay two functions rather than one: this one substitutes a NAME, while
# refetch_hint's two answers differ in the verb as well ('upgrade' against
# 'install --download'), so neither can be derived from the other by renaming.
#
# The one case it cannot spell is a kit tree somebody unpacked by hand: marker
# 2 is there, so this says 'redoku', but no PATH entry was ever written for it.
# That state now has its own answer wherever it matters — resolve_kit_root
# refuses it outright and names the full path to run — and inventing a third
# spelling here would be a branch for a case the surrounding messages already
# turn away.
cli_name() {
  if [ "$IN_KIT" -eq 1 ] || [ -n "$KIT_DIR" ]; then
    printf '%s\n' "redoku"
  else
    printf '%s\n' "bin/redoku"
  fi
}

usage() {
  cat <<'EOF'
redoku — put the rm2fb display server and the reDoku game on a reMarkable 2

The same script, reached two ways: 'redoku' from a released kit (it lives in
~/.redoku/current/bin/ and is normally reached through ~/.local/bin/redoku),
or 'bin/redoku' from a checkout. Everything below is spelled 'redoku'; add
the 'bin/' when you are in a checkout.

usage:
  redoku install          copy the binaries to the device and install them
                          (safe to re-run: idempotent from any state)
  redoku upgrade          fetch a newer release into the kit — see 'keeping
                          it up to date' below
  redoku play             run the game on the device
  redoku uninstall        return the device to stock (safe, idempotent)
  redoku status           show what's running on the device, and which kit
                          this machine has
  redoku shell            open an SSH shell on the device

how it connects (the default just works):
  Plug the reMarkable in over USB and run a command. You'll be asked for
  the device's SSH password, shown on the device under
  Settings -> Help -> Copyrights and licenses. Your ~/.ssh/config is
  deliberately ignored so nothing in it can interfere. The connection is
  kept open for 2 minutes, so back-to-back commands ask only once.

playing the game:
  'install' stages the whole tree — the display server, a decoy "Sudoku"
  document it drops into the stock library, the watcher that launches the
  game when you tap it, and the game binary — and can be re-run at any time.
  A kit ships all four prebuilt; in a checkout the game is whatever
  'make build' last produced, and install warns and puts everything else on
  alone when there isn't one. 'play' then only refreshes that one binary
  (/home/root/redoku/bin/redoku) and starts it, so working on the game never
  means restarting the display server or re-tapping the decoy. 'uninstall'
  always takes the decoy and its watcher back out (the decoy can't outlive
  them — a document that launches nothing is worse than none);
  'uninstall --purge' also removes everything else from the device, and
  'uninstall --self' removes the kit from this machine.

keeping it up to date (kit installs):
  'upgrade' fetches the latest release into the kit, points <kit>/current at
  it and keeps the version 'current' pointed at before, so a rollback is one
  symlink swap. It is host-side only and never opens an ssh connection — run
  'install' afterwards to put the new version on the device. A 'current' that
  is missing, dangling, or pointing at an incomplete tree is repaired rather
  than refused. Both 'upgrade' and 'uninstall --self' refuse in a checkout,
  where there is no kit to act on — unless --kit or $REDOKU_HOME names one
  outright, which is a different request and is honoured. A tarball you
  unpacked by hand is not an installed kit either: it has no root to repoint
  or prune, so both refuse there too and say how to install it properly.

options:
  -H, --host HOST         device address or ssh alias   (default: 10.11.99.1)
  -u, --user USER         ssh user                      (default: root)
  -F, --ssh-config FILE   use YOUR ssh config (aliases, keys, etc.) instead
                          of the safe default, e.g.:  -F ~/.ssh/config
  -i, --identity FILE     ssh private key to use
  -a, --artifacts DIR     where the built armv7 binaries are (install only;
                          default: build/rm2fb/dist/ — if empty, install
                          offers to download the released ones)
      --download          install: fetch the released binaries instead of
                          looking for a local build. Without --kit they land
                          in build/download/<tag>/ and nothing outside this
                          directory is touched.
      --kit DIR           install, upgrade, uninstall --self: the kit root.
                          'install --download' unpacks into DIR and points
                          DIR/current at it; any kit-mode install also writes
                          the 'redoku' PATH entry for DIR. upgrade and
                          uninstall --self operate on the kit already there.
                          The curl|sh installer passes ~/.redoku; set it
                          yourself with --kit or $REDOKU_HOME. Running from
                          inside a kit, it needs no flag at all.
      --bin-dir DIR       install, upgrade, uninstall --self: where that PATH
                          entry goes (default: ~/.local/bin, $REDOKU_BIN_DIR).
                          If it isn't on your PATH the 'export' line is
                          printed for you to add — no shell rc file is ever
                          edited — and a 'redoku' already there that this
                          installer didn't write is left exactly as it is.
      --no-symlink        install, upgrade: write no PATH entry at all
      --force             install: proceed on an untested firmware version
      --purge             uninstall: also delete /home/root/redoku on the
                          DEVICE (nothing on this machine)
      --self              uninstall: once the device is back to stock, also
                          remove the kit and our PATH entry from THIS machine
                          (nothing extra on the device). Refused in a
                          checkout, where there is no kit to remove — unless
                          --kit or $REDOKU_HOME names one.
      --seconds N         play: stop the game after N seconds instead of
                          running it interactively (unattended smoke test)
  -y, --yes               don't ask for confirmation
  -n, --dry-run           show what would happen without touching anything
  -h, --help              this help

environment:
  REDOKU_HOME             kit root, same as --kit DIR. install has no default
                          for it (a kit install is asked for, never guessed).
                          Unset, upgrade / uninstall --self / status use the
                          kit they are running from — a properly installed one
                          only, whose version directory is named after its own
                          VERSION; a hand-unpacked tree is refused with an
                          explanation, never guessed around. From a checkout,
                          where there is no kit tree at all, they use
                          ~/.redoku.
  REDOKU_BIN_DIR          PATH entry dir, same as --bin-dir DIR
  REDOKU_VERSION          pin a release tag instead of taking the latest —
                          for upgrade too, which will then install exactly
                          that version even if it is older than the one you
                          have, and say that it did
  REDOKU_BASE_URL         where releases are fetched from — for a fork, a
                          mirror, or a file:// directory offline

safety:
  The install only ADDs files (no kernel, boot, or partition changes),
  binaries are checked to really be 32-bit ARM before they leave your
  machine, and the on-device installer rolls back to stock on any failure.
  Anything downloaded is checked against the sha256 published beside it
  before it is unpacked, and nothing unverified is ever run or installed —
  which proves the bytes arrived intact, not that the release is authentic
  (the README says why there is no signature). If the device ever seems
  stuck, hold the power button ~10 s: it reboots and a broken display
  server disarms itself.
EOF
}

# ---- argument parsing -------------------------------------------------

while [ $# -gt 0 ]; do
  case $1 in
    install|upgrade|uninstall|play|status|shell)
      [ -z "$CMD" ] || die "two commands given: '$CMD' and '$1'"
      CMD=$1 ;;
    -H|--host)       [ $# -ge 2 ] || die "$1 needs a value"; HOST=$2; shift ;;
    -u|--user)       [ $# -ge 2 ] || die "$1 needs a value"; RUSER=$2; shift ;;
    -F|--ssh-config) [ $# -ge 2 ] || die "$1 needs a value"; SSH_CFG=$2; shift ;;
    -i|--identity)   [ $# -ge 2 ] || die "$1 needs a value"; IDENTITY=$2; shift ;;
    -a|--artifacts)  [ $# -ge 2 ] || die "$1 needs a value"; ARTIFACTS=$2; shift ;;
    --download)      DOWNLOAD=1 ;;
    --kit)           [ $# -ge 2 ] || die "$1 needs a value"; KIT_DIR=$2; KIT_DIR_SET=1; shift ;;
    --bin-dir)       [ $# -ge 2 ] || die "$1 needs a value"; BIN_DIR=$2; BIN_DIR_SET=1; shift ;;
    --no-symlink)    NO_SYMLINK=1 ;;
    --force)         FORCE=1 ;;
    --purge)         PURGE=1 ;;
    --self)          SELF=1 ;;
    --seconds)       [ $# -ge 2 ] || die "$1 needs a value"; PLAY_SECS=$2; PLAY_SECS_SET=1; shift ;;
    -y|--yes)        YES=1 ;;
    -n|--dry-run)    DRY=1 ;;
    -h|--help)       usage; exit 0 ;;
    *)               die "unknown argument '$1' — see $(cli_name) --help" ;;
  esac
  shift
done

[ -n "$CMD" ] || { usage; exit 1; }
command -v ssh >/dev/null 2>&1 || die "no 'ssh' on this machine"
[ -z "$SSH_CFG" ]  || [ -f "$SSH_CFG" ]  || die "ssh config not found: $SSH_CFG"
[ -z "$IDENTITY" ] || [ -f "$IDENTITY" ] || die "identity file not found: $IDENTITY"
[ -z "$ARTIFACTS" ] || [ -d "$ARTIFACTS" ] || die "artifacts directory not found: $ARTIFACTS"
[ "$FORCE" -eq 0 ] || [ "$CMD" = install ]   || die "--force only applies to install"
[ "$PURGE" -eq 0 ] || [ "$CMD" = uninstall ] || die "--purge only applies to uninstall"
[ "$SELF" -eq 0 ]  || [ "$CMD" = uninstall ] || die "--self only applies to uninstall"
[ -z "$ARTIFACTS" ] || [ "$CMD" = install ]  || die "--artifacts only applies to install"
[ "$PLAY_SECS_SET" -eq 0 ] || [ "$CMD" = play ] || die "--seconds only applies to play"
# Which commands each kit option reaches, and no more: a --kit on a command
# that would ignore it is a mistake worth saying out loud rather than
# silently accepting.
#
# --download stays install-only, because 'upgrade' fetches unconditionally —
# that is what it IS — and there is nothing for the flag to switch on. The
# other three widen exactly as far as they have a job to do: --kit and
# --bin-dir name the kit root and the PATH entry, which 'upgrade' rewrites and
# 'uninstall --self' removes, and --no-symlink says "write no PATH entry",
# which 'upgrade' must honour too or an upgrade would hand a wrapper to
# somebody who installed with --no-symlink precisely to avoid one.
[ "$DOWNLOAD" -eq 0 ]    || [ "$CMD" = install ] || die "--download only applies to install"
# On `uninstall` the test is --self, not the command: a plain `uninstall`
# touches nothing on this machine, so it has no kit root and no PATH entry for
# these to name. Checked as written rather than as "$CMD = uninstall", because
# a message that says "and uninstall --self" while the code accepts any
# uninstall states a rule it does not enforce — and silently ignoring an option
# somebody typed is the exact thing the comment above says not to do.
[ "$KIT_DIR_SET" -eq 0 ] || [ "$CMD" = install ] || [ "$CMD" = upgrade ] || \
  { [ "$CMD" = uninstall ] && [ "$SELF" -eq 1 ]; } || \
  die "--kit only applies to install, upgrade and uninstall --self"
[ "$BIN_DIR_SET" -eq 0 ] || [ "$CMD" = install ] || [ "$CMD" = upgrade ] || \
  { [ "$CMD" = uninstall ] && [ "$SELF" -eq 1 ]; } || \
  die "--bin-dir only applies to install, upgrade and uninstall --self"
[ "$NO_SYMLINK" -eq 0 ]  || [ "$CMD" = install ] || [ "$CMD" = upgrade ] || \
  die "--no-symlink only applies to install and upgrade"
# --bin-dir says where the PATH entry goes; --no-symlink says there isn't
# one. Honouring either by quietly dropping the other is exactly the "it did
# something, just not what you asked for" this script is written to avoid.
# Only the FLAGS conflict: $REDOKU_BIN_DIR sitting in the environment of
# someone who passes --no-symlink is not a contradiction, it's a default
# going unused.
[ "$BIN_DIR_SET" -eq 0 ] || [ "$NO_SYMLINK" -eq 0 ] || \
  die "--bin-dir and --no-symlink contradict each other — pass --bin-dir DIR to move the PATH entry, or --no-symlink to write none, not both"
# The same standard --seconds sets a few lines below, for the same reason it
# gives: an option handed an EMPTY value must not fall through to meaning "not
# given at all". "--kit ''" would silently switch a kit install into checkout
# mode — the mode is decided by whether --kit is present (design doc §5.2), so
# an empty one decides the opposite of what was asked — and "--bin-dir ''"
# resolves to $PWD/ and drops the wrapper in whatever directory you happened
# to be standing in. Checked on the FLAG, not on the value, so an unset or
# empty $REDOKU_HOME still means "no --kit" as its ${:-} default says.
[ "$KIT_DIR_SET" -eq 0 ] || [ -n "$KIT_DIR" ] || \
  die "--kit wants a directory, not an empty value — e.g. --kit ~/.redoku"
[ "$BIN_DIR_SET" -eq 0 ] || [ -n "$BIN_DIR" ] || \
  die "--bin-dir wants a directory, not an empty value — e.g. --bin-dir ~/.local/bin"
# It ends up as 'sleep N' on the device, which wants a plain whole number.
# Checked whenever --seconds was given at all (PLAY_SECS_SET), not just when
# its value happens to be non-empty — "--seconds ''" must not silently fall
# through to interactive play.
if [ "$PLAY_SECS_SET" -eq 1 ]; then
  # Three arms, first match wins, and the order is the whole point. Leading
  # zeros are REJECTED rather than stripped. Stripping them made the message
  # match the input ('000000' is zero seconds, and telling someone that is
  # more than 24 hours is worse than saying nothing) but it also carried
  # '086400' past the length arm below, which judges a number by how long it
  # is — widening what --seconds accepts, which was never the point.
  # Rejecting gets both: the message names the real complaint, and the range
  # stays 1..86400 however the number is spelled. Bare '0' is one character
  # short of that arm and falls through to "at least 1 second", which is
  # exactly what it is.
  case $PLAY_SECS in
    *[!0-9]* | '') die "--seconds wants whole seconds, not '$PLAY_SECS'" ;;
    0?*)           die "--seconds wants no leading zeros, not '$PLAY_SECS'" ;;
    ??????*)       die "--seconds wants at most 86400 seconds (24h), not '$PLAY_SECS'" ;;
  esac
  # At most five digits reach these, so neither can overflow the shell's own
  # integers and leak a raw diagnostic in place of a message.
  [ "$PLAY_SECS" -ge 1 ]     || die "--seconds wants at least 1 second"
  [ "$PLAY_SECS" -le 86400 ] || die "--seconds wants at most 86400 seconds (24h)"
fi

TARGET=$RUSER@$HOST

# ---- ssh plumbing -----------------------------------------------------

# One ssh invocation with the common options prepended. ControlMaster
# keeps the (password-authenticated) connection open and reuses it, so
# the password is asked at most once per 2 minutes.
ssh_run() {
  if [ -n "$IDENTITY" ]; then set -- -i "$IDENTITY" "$@"; fi
  if [ -n "$SSH_CFG" ]; then
    set -- -F "$SSH_CFG" "$@"
  else
    set -- -F /dev/null \
           -o UserKnownHostsFile="$KNOWN_HOSTS" \
           -o StrictHostKeyChecking=accept-new "$@"
  fi
  set -- -o ConnectTimeout=15 \
         -o ControlMaster=auto \
         -o ControlPath="$CTL_PATH" \
         -o ControlPersist=120 "$@"
  ssh "$@"
}

# Run one command on the device. Stdin/stdout pass through.
remote() {
  if [ "$DRY" -eq 1 ]; then
    printf '==> [dry-run] ssh %s -- %s\n' "$TARGET" "$1" >&2
    return 0
  fi
  ssh_run "$TARGET" "$1"
}

connect() {
  mkdir -p "$HOME/.ssh" && chmod 700 "$HOME/.ssh"
  if [ -n "$SSH_CFG" ]; then
    say "connecting to $TARGET (using your ssh config: $SSH_CFG)"
  else
    say "connecting to $TARGET — your ~/.ssh/config is intentionally ignored (see --help)"
    say "if asked for a password: it's shown on the device under"
    say "  Settings -> Help -> Copyrights and licenses"
  fi
  [ "$DRY" -eq 1 ] && return 0
  if remote true; then return 0; fi
  if [ -n "$SSH_CFG" ]; then
    die "could not connect to $TARGET
  - ssh config 'Host' blocks match the name you dial: if your config has
    the device under an alias, pass that alias too, e.g.:
      $(cli_name) $CMD --ssh-config $SSH_CFG --host <alias>
  - Or drop --ssh-config to use plain password auth over USB."
  fi
  die "could not connect to $TARGET
  - Is the device plugged in via USB and awake? (tap the screen)
  - Did ssh report a host-key mismatch above? That happens after a device
    reset/reflash: delete $KNOWN_HOSTS and try again.
  - Password auth disabled on the device? Use your own setup with:
      --ssh-config ~/.ssh/config --host <alias>"
}

confirm() {
  [ "$YES" -eq 1 ] && return 0
  [ "$DRY" -eq 1 ] && return 0
  [ -t 0 ] || die "not running in a terminal — add --yes to skip confirmation"
  printf '%s [y/N] ' "$1"
  read -r _ans || die "aborted — nothing was touched"
  case $_ans in
    y|Y|yes|Yes|YES) ;;
    *) die "aborted — nothing was touched" ;;
  esac
}

# Stream a file to the device over the ssh connection (no scp: modern
# scp speaks SFTP, which the device's Dropbear may not) and verify the
# byte count on the other side. Unlink before writing: overwriting a
# RUNNING binary fails with ETXTBSY, and truncating a mapped .so can
# crash its user — a fresh inode has neither problem, so reinstalling
# over a live install just works.
push_file() { # push_file <local> <remote-path>
  # Belt and braces: every remote path is a hardcoded literal under
  # $REMOTE_DIR — refuse anything else so the rm -f below can never
  # reach outside the redoku directory.
  case $2 in
    "$REMOTE_DIR"/?*) ;;
    *) die "internal error: refusing to write outside $REMOTE_DIR: '$2'" ;;
  esac
  say "  sending $(basename "$1")"
  if [ "$DRY" -eq 1 ]; then
    printf '==> [dry-run] copy %s -> %s:%s\n' "$1" "$TARGET" "$2" >&2
    return 0
  fi
  remote "rm -f '$2' && cat > '$2'" < "$1"
  _lsize=$(wc -c < "$1" | tr -d '[:space:]')
  _rsize=$(remote "wc -c < '$2'" | tr -d '[:space:]')
  [ "$_lsize" = "$_rsize" ] || \
    die "copy of $1 arrived truncated ($_rsize of $_lsize bytes) — bad cable? try again"
}

# ---- finding + checking the built binaries ----------------------------

_hex_at() { dd if="$1" bs=1 skip="$2" count="$3" 2>/dev/null | od -An -tx1 | tr -d ' \n'; }

# 32-bit ARM ELF: magic 7f 'E' 'L' 'F' + ELFCLASS32, e_machine EM_ARM.
# Same check device/install.sh repeats on the device.
is_arm_elf() {
  [ "$(_hex_at "$1" 0 5)" = "7f454c4601" ] && [ "$(_hex_at "$1" 18 2)" = "2800" ]
}

# Print the unique 32-bit-ARM build of $2 under directory $1.
# Returns 1 when there is none, 2 when there are several.
pick_in() {
  [ -d "$1" ] || return 1
  _match=
  _count=0
  while IFS= read -r _f; do
    [ -n "$_f" ] || continue
    is_arm_elf "$_f" || continue
    _count=$((_count + 1))
    if [ "$_count" -eq 1 ]; then
      _match=$_f
    else
      [ "$_count" -eq 2 ] && \
        printf 'ERROR: several ARM builds of %s under %s:\n  %s\n' "$2" "$1" "$_match" >&2
      printf '  %s\n' "$_f" >&2
    fi
  done <<EOF
$(find "$1" -type f -name "$2" 2>/dev/null)
EOF
  if [ "$_count" -eq 0 ]; then return 1; fi
  if [ "$_count" -gt 1 ]; then
    printf 'pass the right one with:  --artifacts DIR\n' >&2
    return 2
  fi
  printf '%s\n' "$_match"
}

pick_artifact() { # $1 = filename; prints the path
  pick_in "${ARTIFACTS:-$KIT_ROOT/build/rm2fb/dist}" "$1"
}

# Three rules in this file answer three DIFFERENT questions about "am I in a
# kit?", and confusing them produces wrong advice, so each says which question
# it answers:
#
#   in_kit_tree      — where did the artifacts this run installs come from?
#                      A kit around me, or one I just downloaded. This is the
#                      PROVENANCE question, and it is the one every "how do I
#                      fix a missing file" message needs.
#   $KIT_VERSION     — am I, this script, a release build? (design doc §5.1's
#                      marker 1.) It answers "which version am I", not "where
#                      did these binaries come from".
#   $REPO/tools/mkdecoy.rb (build_decoy) — is a GENERATOR available to
#                      regenerate with? That is a third question again, and
#                      the only one whose answer is a tool rather than a
#                      provenance.
#
# in_kit_tree is true both when this CLI is running from inside a kit
# (marker 2) and when a download moved KIT_ROOT off $REPO — a checkout-mode
# `install --download` unpacks to build/download/<tag>/, and a game that came
# out of THAT tarball must not be met with "make clean && make build" either.
in_kit_tree() { [ "$IN_KIT" -eq 1 ] || [ "$KIT_ROOT" != "$REPO" ]; }

# Did the artifacts this run installs ship prebuilt, rather than come out of a
# local build? in_kit_tree is the primary answer — but $KIT_VERSION still
# counts for one state it cannot see: a STAMPED CLI running with no kit around
# it and nothing downloaded yet (the bootstrap's temp directory) has no
# `make build` to offer either, because it has no checkout to run it in.
game_is_prebuilt() { in_kit_tree || [ "$KIT_VERSION" != dev ]; }

# The command that re-fetches whatever the prebuilt artifacts came from —
# printed by every "this kit is incomplete or corrupt" message in this file,
# because a fix that names the wrong command is the class of wrong advice
# design doc §7's last paragraph exists to eliminate.
#
# Two answers, because there are two things a prebuilt tree can be sitting
# in. A KIT — one this CLI runs from, or one --kit named — has a root, a
# 'current' symlink and versions to roll between, which is what `redoku
# upgrade` (a later task in this milestone) operates on. A CHECKOUT that
# downloaded into build/download/<tag>/ has none of those; the next task
# makes `upgrade` refuse in a checkout outright, so naming it there would
# send someone to a command written to turn them away. The command that
# actually applies is the one that put the tree there in the first place.
refetch_hint() {
  if [ "$IN_KIT" -eq 1 ] || [ -n "$KIT_DIR" ]; then
    printf '%s\n' "redoku upgrade"
  else
    printf '%s\n' "bin/redoku install --download"
  fi
}

# The cross-built game, into $GAME. Its path is fixed (mruby's rake decides
# it), so there is nothing to search for and no --artifacts override; it is
# checked to really be 32-bit ARM like everything else that leaves this
# machine.
#
# Returns 1 with $GAME empty and $GAME_WHY explaining it, because the two
# callers want opposite things: 'install' installs the display server —
# which does not need the game and must stay installable on a fresh clone or
# while the game build is broken — so it warns and carries on, while 'play'
# has nothing to run and dies.
find_game() {
  GAME=$KIT_ROOT/build/rm2/bin/redoku
  GAME_WHY=
  # In a checkout a missing or wrong-arch game means a build step was never
  # run, so the hint names the build. Where this file shipped prebuilt
  # (design doc §3.2) there is no build to run, so the SAME two conditions
  # instead mean the download is incomplete or corrupt, and the fix is to
  # re-fetch it — by whichever command actually applies, which is
  # refetch_hint's job and not one fixed string's.
  #
  # The question is PROVENANCE, so it goes through game_is_prebuilt, not
  # through $KIT_VERSION alone. A checkout-mode `install --download` unpacks
  # a released game into build/download/<tag>/ while this CLI is still an
  # unstamped dev build; telling that user to "rebuild with: make clean &&
  # make build" would be advice about a file no build of theirs produced —
  # and telling them "redoku upgrade" would be advice about a kit root they
  # do not have.
  if [ ! -f "$GAME" ]; then
    if game_is_prebuilt; then
      GAME_WHY="no game binary at $GAME — this kit is incomplete or corrupt, re-download it with:  $(refetch_hint)"
    else
      GAME_WHY="no game binary at $GAME — cross-build it with:  make build"
    fi
  elif ! is_arm_elf "$GAME"; then
    # One line, like the message above it: both callers print it as a single
    # indented continuation line, where an embedded newline would lose its
    # prefix and its indentation.
    if game_is_prebuilt; then
      GAME_WHY="$GAME is not 32-bit ARM — this kit is corrupt, re-download it with:  $(refetch_hint)"
    else
      GAME_WHY="$GAME is not 32-bit ARM (a host build?) — rebuild with:  make clean && make build"
    fi
  fi
  [ -z "$GAME_WHY" ] || { GAME=; return 1; }
}

# ---- the decoy document (M4) --------------------------------------------

# Puts the decoy document at $DECOY_DIR and sets DECOY_FILES to the four
# sidecar files there, plus DECOY_NOTE — one clause saying where they came
# from, which the install plan prints. Its uuid never becomes a shell
# variable here: DECOY_FILES is discovered from what is actually on disk,
# the same "get it from the tool instead of hardcoding a second copy of
# the constant" reasoning device/install.sh's header gives for reading it
# back out of watch.conf on the device side.
#
# In a checkout it builds them fresh via tools/mkdecoy.rb (host-side CRuby,
# stdlib only — no gems, no bundler), exactly as it always has. That runs on
# --dry-run too: unlike 'make rm2fb' below (a slow Docker cross-compile this
# function deliberately does NOT touch), it is a fast, local,
# read-only-to-the-device operation, and the dry-run plan needs its real
# output — real filenames — to say anything concrete.
#
# Inside a kit there is nothing to run and, by design, no ruby on the machine
# to run it with: shipping the decoy prebuilt (design doc §3.2) is precisely
# what retires that dependency, and mkdecoy.rb is deterministic by
# construction (DEFAULT_UUID and PAGE_UUID are fixed constants), so the files
# CI generated once are byte-for-byte the files this machine would have
# generated. What decides is therefore the GENERATOR's presence, not ruby's:
# where $REPO/tools/mkdecoy.rb exists we regenerate as before, and where it
# does not we take $KIT_ROOT/build/decoy/ as it shipped — validated exactly
# the way generated output is validated, so an incomplete kit is caught here
# rather than halfway through a device install. That is also what makes the
# "no 'ruby' on this machine" die below unreachable inside a kit rather than
# merely unlikely, which was the whole point of shipping the decoy prebuilt.
build_decoy() {
  DECOY_DIR=$KIT_ROOT/build/decoy
  _bd_generated=0
  # $KIT_VERSION guards the generator, and it is a security gate rather than an
  # optimisation. This is the one place in this file that EXECUTES something
  # found relative to $REPO, and $REPO is derived from where this script sits —
  # so it is only ever trustworthy when this script sits somewhere trustworthy.
  # A released CLI can be run from anywhere: the bootstrap's temp directory
  # (fixed to be 0700 in tools/install.sh, but that is one file's promise), or
  # whatever directory somebody `curl -O`'d it into to read it first — and if
  # that is /tmp or below, $REPO is world-writable and a pre-planted
  # <dir>/tools/mkdecoy.rb runs as them.
  #
  # A STAMPED CLI has no legitimate generator beside it in any case: tools/
  # is not part of the §3.2 kit layout, so a kit's CLI never has one, and a
  # bootstrap CLI has no checkout around it either. Only an unstamped one — a
  # checkout, where $REPO/tools/mkdecoy.rb is the file the developer is editing
  # — should ever run it. So the condition that closes the hole is also the one
  # that was semantically right to begin with.
  if [ "$KIT_VERSION" = dev ] && [ -f "$REPO/tools/mkdecoy.rb" ]; then
    _bd_generated=1
    DECOY_NOTE="regenerated by tools/mkdecoy.rb, same uuid every run"
    command -v ruby >/dev/null 2>&1 || \
      die "no 'ruby' on this machine — tools/mkdecoy.rb needs a stdlib-only
  CRuby (no gems, no bundler) to build the decoy document. Install one
  (your OS package manager or a version manager both work) and try again."
    say "building the decoy document (tools/mkdecoy.rb)"
    ruby "$REPO/tools/mkdecoy.rb" --out "$DECOY_DIR" >/dev/null || \
      die "tools/mkdecoy.rb failed — re-run it directly for the full error:
    ruby $REPO/tools/mkdecoy.rb --out $DECOY_DIR"
  else
    DECOY_NOTE="shipped prebuilt in this kit, same uuid every install"
    say "using the decoy document that shipped with this kit"
  fi
  DECOY_FILES=$(find "$DECOY_DIR" -maxdepth 1 -type f \
    \( -name '*.pdf' -o -name '*.metadata' -o -name '*.content' -o -name '*.pagedata' \) \
    2>/dev/null | sort)
  if [ "$_bd_generated" -eq 1 ]; then
    [ -n "$DECOY_FILES" ] || \
      die "tools/mkdecoy.rb ran but $DECOY_DIR has none of the expected decoy files"
    [ -f "$DECOY_DIR/watch.conf" ] || \
      die "tools/mkdecoy.rb ran but didn't write $DECOY_DIR/watch.conf"
  else
    # Same two conditions, opposite cause and opposite fix: nothing ran, so a
    # missing file means the kit arrived incomplete, and re-fetching it is
    # the only thing that helps. Same wording find_game uses for the same
    # reason.
    [ -n "$DECOY_FILES" ] || \
      die "$DECOY_DIR has none of the expected decoy files (.pdf, .metadata, .content, .pagedata) — this kit is incomplete or corrupt, re-download it with:  $(refetch_hint)"
    [ -f "$DECOY_DIR/watch.conf" ] || \
      die "$DECOY_DIR/watch.conf is missing — this kit is incomplete or corrupt, re-download it with:  $(refetch_hint)"
  fi
}

# ---- downloading a released kit (design doc §6) --------------------------

# A tag is not just a string here: it becomes a directory name under the kit
# root, a path component of every asset URL, and — through prune_kit — the
# name of something this script later deletes. One of the four places it can
# come from is the Location header of a redirect, i.e. remote-controlled
# input, so it is checked wherever it enters and not only there. Refusing
# outright beats quoting carefully: a tag of ".." or one carrying a "/" would
# put the unpacked tree, or the deletion, somewhere else entirely. Same class
# of guard as push_file's refusal to write outside $REMOTE_DIR.
valid_tag() {
  case $1 in
    '' | . | ..)       return 1 ;;
    -*)                return 1 ;;  # would be read as an option downstream
    *[!A-Za-z0-9._-]*) return 1 ;;  # anything a path component shouldn't hold
    # A tag beginning ".staging." is a legal tag by every rule above, and it
    # would be a version directory sitting in the kit root under the exact
    # name clean_stale_staging sweeps — so the next download of anything at
    # all would rm -rf a complete, current version. Both remote sources of a
    # tag (a Location header, a tarball's VERSION) can produce one, which is
    # what makes this the same class of guard as §6.2's ^redoku/ check rather
    # than a tidiness rule. Refusing the tag is the fix rather than teaching
    # the sweep to look inside candidates: the sweep runs before a download,
    # when the directory it is looking at may legitimately be half-written.
    .staging.*)        return 1 ;;
    # The kit root's OTHER reserved name, and the same rule as the line above
    # for the same reason: design doc §5.3 gives 'current' to the symlink, so a
    # tag spelling it is a version directory competing for a name this
    # installer already owns. Measured, not theorised — with this arm removed,
    # a release whose VERSION reads "current" walks an existing kit through all
    # four of these at once:
    #
    #   * the reuse gate stats <kit>/current, FOLLOWS it into the live version
    #     directory, finds a complete tree there and announces "current is
    #     already unpacked — reusing it", which is a lie about a symlink;
    #   * the repoint's `rm -f current; ln -s "$TAG" current` produces
    #     current -> current, and the read-back guard passes because the loop's
    #     own name IS the tag;
    #   * prune_kit is then told to keep "current" and the one-back version,
    #     so it rm -rf's the rollback target — a recursive delete of a good
    #     version directory, steered by remote input;
    #   * and the PATH wrapper is rewritten through the loop, so the command
    #     the resulting error message tells you to run is itself dead (ELOOP).
    #
    # On a kit root with no 'current' yet it is worse in a quieter way: the
    # tree is moved in as a REAL directory called 'current', and every later
    # install into that root dies at "current is not a symlink" until somebody
    # removes it by hand. "current" is also the word a user reaches for when
    # they mean "the current release", so REDOKU_VERSION=current is a plain
    # typo, not only an attack.
    current)           return 1 ;;
  esac
}

# Which sha256 tool this machine has, decided once and remembered in
# $SHA256_TOOL. Called BEFORE anything is downloaded, not merely before a
# digest is computed, so a machine that cannot verify a download never starts
# one — design doc §7's "refuses; never falls through to an unverified
# install" is a promise about what was fetched as much as about what was run.
sha256_tool() {
  [ -z "$SHA256_TOOL" ] || return 0
  if command -v shasum >/dev/null 2>&1; then
    SHA256_TOOL=shasum
  elif command -v sha256sum >/dev/null 2>&1; then
    SHA256_TOOL=sha256sum
  elif command -v openssl >/dev/null 2>&1; then
    SHA256_TOOL=openssl
  else
    die "no sha256 tool (shasum, sha256sum, or openssl) on this machine, so a
  downloaded kit could not be verified — refusing to fetch one at all rather
  than install it unchecked. Install any one of those three and try again, or
  $OFFLINE_ROUTES."
  fi
}

# sha256_of <file> — its sha256, as lowercase hex.
#
# Digest-and-compare, never `shasum -c`: the -c input format and exit
# behaviour differ between BSD and GNU, and it forces the local filename to
# match the one recorded in the checksum file — which ours never does, since
# the file is downloaded into a temp dir under a name of our choosing.
# Computing the digest here and string-comparing it is portable and produces
# a message with both digests in it instead of `shasum -c`'s bare "FAILED".
#
# The same three-tool fallback, in the same order, as tools/install.sh's
# digest step and tools/mkkit.sh's mkkit_digest. Three copies on purpose, not
# drift: the bootstrap ships standalone as a release asset and the packager
# runs in CI with no CLI beside it, so neither of them can source this one.
#
# Each `|| die` earns its keep: a digest tool that EXISTS but fails (a broken
# install, a permissions problem) must not be swallowed by errexit into a
# silent, wordless exit right after a successful download.
sha256_of() {
  sha256_tool
  case $SHA256_TOOL in
    shasum)
      _sha_line=$(shasum -a 256 "$1") || \
        die "shasum failed on $1 — its own error is above; try the install again"
      _sha_hex=${_sha_line%% *} ;;
    sha256sum)
      _sha_line=$(sha256sum "$1") || \
        die "sha256sum failed on $1 — its own error is above; try the install again"
      _sha_hex=${_sha_line%% *} ;;
    openssl)
      # shasum/sha256sum print "<hex>  <path>" (hex FIRST field); openssl
      # prints "SHA2-256(<path>)= <hex>" (hex LAST field, behind a label that
      # differs between OpenSSL and LibreSSL) — one "first field" rule cannot
      # cover both shapes.
      _sha_line=$(openssl dgst -sha256 "$1") || \
        die "openssl dgst failed on $1 — its own error is above; try the install again"
      _sha_hex=${_sha_line##* } ;;
  esac
  # [:upper:]/[:lower:] rather than the A-F/a-f range form: POSIX leaves
  # range-expression collation locale-dependent. None of the three tools above
  # emits uppercase, so this can only ever be a no-op in practice — which is
  # exactly why it should be written the form that cannot misfire.
  printf '%s\n' "$_sha_hex" | tr '[:upper:]' '[:lower:]'
}

# abs_path <path> — <path> made absolute WITHOUT touching the disk, so a
# --dry-run can print a concrete plan about a directory it must not create.
# Deliberately not fully resolved (no symlink chase, no ".." collapse): that
# needs the directory to exist, and happens in fetch_kit once it does.
abs_path() {
  case $1 in
    /*) printf '%s\n' "$1" ;;
    *)  printf '%s\n' "$PWD/$1" ;;
  esac
}

# fetch_url <url> <dest> — curl, with a message that names the URL it tried,
# tells "no release published yet" apart from "the tag you pinned does not
# exist", and points at the two offline routes (design doc §7). curl's own
# stderr does none of those: -s suppresses it, and -S cuts it back to a bare
# HTTP or DNS line with no idea what the caller was trying to achieve.
fetch_url() {
  curl -fsSL -o "$2" "$1" && return 0
  if [ -n "${REDOKU_VERSION:-}" ]; then
    die "could not download $1
  REDOKU_VERSION=$REDOKU_VERSION may not exist as a release, or you're offline.
  Unset it to take the latest release, or $OFFLINE_ROUTES."
  elif [ -n "$TAG" ]; then
    die "could not download $1
  Release $TAG may have been deleted, or you're offline.
  $OFFLINE_ROUTES."
  fi
  die "could not download $1
  There may be no published release yet, or you're offline.
  $OFFLINE_ROUTES."
}

# resolve_tag — sets $TAG to the release tag to fetch, or leaves it EMPTY
# when only a download can answer. That last case is design doc §6.1's step
# 4, and it belongs to fetch_kit, not here: this function makes at most one
# cheap request and never downloads anything, because --dry-run calls it too
# and a dry run downloads nothing.
resolve_tag() {
  TAG=
  # 1. Explicit wins. A value here that cannot be a tag is the user's typo,
  #    so say so rather than silently falling through to "latest" and
  #    installing a version they did not ask for.
  if [ -n "${REDOKU_VERSION:-}" ]; then
    valid_tag "$REDOKU_VERSION" || \
      die "REDOKU_VERSION='$REDOKU_VERSION' can't be used as a release tag — it becomes a
  directory name in your kit root, so it may only hold letters, digits, '.', '_'
  and '-', and it may not be 'current' or begin '.staging.': this installer owns
  those two names inside a kit root. Set it to a published tag (e.g.
  REDOKU_VERSION=v0.3.0), or unset it to take the latest release."
    TAG=$REDOKU_VERSION
    return 0
  fi
  # 2. A released CLI fetches its OWN tag, so the common path — someone
  #    re-running a kit's own installer — resolves nothing at all (§3.3).
  #    Checked like every other source of a tag even though tools/mkkit.sh
  #    stamped it: the point of a guard that runs on every path is that no
  #    path has to be trusted, and a stamp is one `--version` typo away from
  #    putting a slash in a directory name.
  #    Skipped entirely when this run asked for the latest (WANT_LATEST, set
  #    by 'upgrade' — see its declaration at the top of this file for why a
  #    released CLI resolving its own tag is the right answer for 'install'
  #    and the wrong one for 'upgrade').
  if [ "$KIT_VERSION" != dev ] && [ "$WANT_LATEST" -eq 0 ]; then
    valid_tag "$KIT_VERSION" || \
      die "this copy of redoku was stamped KIT_VERSION='$KIT_VERSION', which can't be
  used as a release tag — it becomes a directory name in a kit root, so it may
  only hold letters, digits, '.', '_' and '-', and may not be 'current' or begin
  '.staging.', which are names this installer owns there. The release is
  mis-stamped; pin a known-good one with REDOKU_VERSION=<tag> instead."
    TAG=$KIT_VERSION
    return 0
  fi
  # 3. The Location header of an UN-followed redirect on <base>/latest,
  #    which points at .../releases/tag/<tag>.
  #
  #    NOT `-L` with `%{url_effective}`, however much simpler that looks: an
  #    ASSET url redirects twice — first to /releases/download/<tag>/<asset>,
  #    then to a signed objects.githubusercontent.com URL that does not carry
  #    the tag anywhere in it — so following the chain reports a URL the tag
  #    cannot be read back out of. This is exactly the kind of line someone
  #    "simplifies" later; it is written this way on purpose.
  #
  #    Failing here is not an error. file:// has no redirects whatsoever
  #    (which is why §8's offline tests all take step 4 instead), and a change
  #    in GitHub's redirect shape should cost one extra download, not a broken
  #    install — so every failure below just leaves $TAG empty.
  command -v curl >/dev/null 2>&1 || return 0
  _rt_head=$(curl -fsSI "$BASE_URL/latest" 2>/dev/null) || _rt_head=
  TAG=$(printf '%s\n' "$_rt_head" | tr -d '\r' \
        | sed -n 's#^[Ll]ocation:.*/releases/tag/##p')
  # Whatever came back is remote input: a header shape we could not parse,
  # two Location lines run together, or a deliberately hostile one all arrive
  # here as something that is not a tag, and all get the same answer — fall
  # through to step 4 rather than build a path out of it.
  valid_tag "$TAG" || TAG=
}

# kit_tree_is_complete <dir> — is <dir> a complete, usable §3.2 kit tree?
#
# design doc §6.3's gate: "if <kit>/<tag>/VERSION already exists and the game
# binary there passes is_arm_elf, the download is skipped and the existing tree
# reused". A function because fetch_kit consults it TWICE — once before the
# download, when steps 1-3 already knew the tag, and once after step 4 has read
# the tag out of the tarball — and two copies of it would be two answers free
# to disagree about the same directory.
#
# Checked across the WHOLE tree, not just VERSION plus the ARM gate. is_arm_elf
# reads bytes 0-4 and 18-19 only, so a game binary truncated anywhere past byte
# 20 passes it — and a tree that got as far as copying VERSION and the head of
# the game would then be adopted, `current` repointed at it and a truncated
# binary pushed to the device. This is the gate that decides whether a download
# is discarded, so it looks at files spread across the tree rather than at a
# prefix of it.
kit_tree_is_complete() {
  # A real directory, and not a symlink to one. `-f` and `is_arm_elf` below all
  # follow symlinks, so without this the gate happily reports a SYMLINK
  # complete and the caller then treats the link as the tree — which is how a
  # tag colliding with the kit root's own 'current' got this function to
  # announce "already unpacked" about the live version directory it pointed at.
  # valid_tag now refuses that tag outright, and this is the defence in depth
  # behind it: nothing this function approves can be a link into somewhere
  # else, whatever named it.
  [ -d "$1" ] && [ ! -L "$1" ] && \
  [ -f "$1/VERSION" ] && \
  [ -f "$1/bin/redoku" ] && \
  [ -f "$1/device/install.sh" ] && \
  [ -f "$1/device/uninstall.sh" ] && \
  [ -f "$1/device/redoku-watcher.service" ] && \
  [ -f "$1/build/decoy/watch.conf" ] && \
  [ -f "$1/build/rm2fb/dist/rm2fb_server_swtcon" ] && \
  is_arm_elf "$1/build/rm2/bin/redoku"
}

# kit_dest <layout> <base> <tag> — where fetch_kit puts the unpacked tree.
# The two layouts differ only here (and in staging_parent below), which is why
# fetch_kit itself can be one function serving both — and why plan_download
# calls this rather than re-deriving the same two shapes inline, so the
# --dry-run plan and the fetch it describes cannot drift apart.
kit_dest() {
  case $1 in
    kit)      printf '%s\n' "$2/$3" ;;
    checkout) printf '%s\n' "$2/build/download/$3/redoku" ;;
    *)        die "internal error: unknown fetch_kit layout '$1'" ;;
  esac
}

# staging_parent <layout> <base> — the directory fetch_kit downloads and
# unpacks INTO, before renaming the finished tree to kit_dest's answer.
#
# It is a sibling of the destination, deliberately, and NOT $TMPDIR. `mv` is
# only atomic within one filesystem: on a stock Linux box /tmp is very often
# tmpfs while ~/.redoku is on the root filesystem, so staging under $TMPDIR
# turns the final `mv` into a recursive copy on the DEFAULT path, not an
# exotic one — and a copy interrupted by a full disk or a Ctrl-C leaves a
# half-populated <kit>/<tag>/ behind, which is exactly what design doc §6.2's
# temp-dir-then-mv shape exists to make impossible. Staging beside the
# destination makes the rename a rename again.
#
# ($TMPDIR would have been the obvious home, and `mktemp -d` with a template
# pointed here would have been the obvious way to name it, but a template is
# ruled out on portability grounds — hence the explicit ".staging.<pid>"
# below, swept by clean_stale_staging.)
staging_parent() {
  case $1 in
    kit)      printf '%s\n' "$2" ;;
    checkout) printf '%s\n' "$2/build/download" ;;
    *)        die "internal error: unknown fetch_kit layout '$1'" ;;
  esac
}

# clean_stale_staging <dir> — remove staging directories a killed run left
# behind. Everything short of SIGKILL is covered by fetch_kit's own traps, so
# this only ever has work to do after a `kill -9` or a power cut — but under
# $TMPDIR the OS eventually swept those up for us, and inside the user's kit
# directory nothing does. Named-prefix matched and containment-checked, like
# every other recursive delete in this file.
#
# Two concurrent installs into the same kit root are still not a supported
# thing to do — they would both repoint `current`, and one of them would win
# — but "unsupported" must not be allowed to mean "run A's half-finished
# download is deleted out from under it by run B". Staging under $TMPDIR made
# that impossible for free; staging in the kit root does not, so the pid in
# the directory name is checked with `kill -0` and a live one is left alone.
# Our OWN pid is deliberately not exempted: a leftover carrying it can only be
# a dead run whose pid was reused, and sweeping it is what keeps the mkdir
# below from failing on a name we would then never clean up.
#
# `kill -0` says "does a process with this pid exist AND could I signal it",
# so a staging directory belonging to another USER's live install reads as
# dead here and is swept. That needs two people installing into one shared
# kit root at the same moment, which is further outside "supported" than the
# case this guard exists for.
clean_stale_staging() {
  while IFS= read -r _cs_dir; do
    [ -n "$_cs_dir" ] || continue
    case $_cs_dir in
      "$1"/.staging.?*) ;;
      *) continue ;;
    esac
    _cs_pid=${_cs_dir##*/.staging.}
    if [ "$_cs_pid" != "$$" ]; then
      case $_cs_pid in
        '' | *[!0-9]*) ;;  # not pid-shaped at all: nothing is using it
        *) if kill -0 "$_cs_pid" 2>/dev/null; then continue; fi ;;
      esac
    fi
    rm -rf "$_cs_dir" || \
      say "  WARNING: couldn't remove the leftover staging directory $_cs_dir — delete it by hand to reclaim the space"
  done <<EOF
$(find "$1" -mindepth 1 -maxdepth 1 -type d -name '.staging.*' 2>/dev/null)
EOF
}

# The directory every release asset for this run hangs off. One definition,
# read by both fetch_kit and plan_download.
asset_url_dir() {
  if [ -n "$TAG" ]; then
    printf '%s\n' "$BASE_URL/download/$TAG"
  else
    printf '%s\n' "$BASE_URL/latest/download"
  fi
}

# Which layout and base a download in THIS run would use — design doc §5.2's
# "--kit alone decides it", in one place so the --dry-run plan and the fetch
# that follows it cannot disagree about where the tree lands. Sets
# $FETCH_LAYOUT and $FETCH_TARGET.
fetch_target() {
  if [ -n "$KIT_DIR" ]; then
    FETCH_LAYOUT=kit
    FETCH_TARGET=$KIT_DIR
  else
    FETCH_LAYOUT=checkout
    FETCH_TARGET=$REPO
  fi
}

# There is no way to fetch a release without curl (design doc §7). One
# message, called by fetch_kit and by the --dry-run plan, so a dry run cannot
# promise an install this machine could not perform.
require_curl() {
  command -v curl >/dev/null 2>&1 || \
    die "no 'curl' on this machine, so there is no way to fetch a release —
  $OFFLINE_ROUTES."
}

# is_version_dir <dir> — is <dir> a version directory THIS installer created?
#
# The single test behind every recursive delete in this file, and the reason
# they are provably right rather than merely checked. "Holds a VERSION file"
# was the old test and it is far too weak: a source tree with a VERSION at its
# root is commonplace, so `~/myapp` next to a hand-unpacked kit satisfied it
# and was deleted. The discriminator that actually separates our directories
# from everybody else's is that WE NAME THEM AFTER THEIR OWN CONTENTS:
# tools/mkkit.sh writes the tag into <tree>/VERSION, and fetch_kit unpacks
# that tree to <base>/<TAG> — so for every directory this installer has ever
# created, and for essentially nothing else, basename == the first line of its
# own VERSION.
#
# It survives the states §7 says `upgrade` repairs, which is what rules out the
# obvious alternative of "is it what <root>/current points at": a version
# directory keeps its name when `current` goes missing or dangles.
#
# Symlinks are refused outright rather than followed. A deletion must not be
# steerable by a link somebody dropped in the kit root, and `find` is never
# given -L for the same reason.
is_version_dir() {
  [ -d "$1" ] || return 1
  [ ! -L "$1" ] || return 1
  [ -f "$1/VERSION" ] || return 1
  _ivd_name=${1##*/}
  # Through the same gate a tag passes on the way in, so a directory named
  # 'current' or '.staging.7' can never be read back out as a version.
  valid_tag "$_ivd_name" || return 1
  _ivd_ver=
  # `|| true` for the reason every read of a VERSION file in this file has it:
  # `read` returns non-zero at EOF even when it DID fill the variable, which a
  # file with no trailing newline produces. An unreadable file leaves the
  # variable empty, which fails the comparison below — the safe direction.
  read -r _ivd_ver < "$1/VERSION" 2>/dev/null || true
  [ "$_ivd_ver" = "$_ivd_name" ]
}

# looks_like_our_tree <dir> — is <dir> STRUCTURALLY one of our version trees?
# A tag-shaped name holding the §3.2 layout's own bin/redoku and
# device/install.sh.
#
# This is the test for "is this ROOT a kit", and it is deliberately a different
# question from is_version_dir's "may this directory be deleted". The two look
# interchangeable and are not, which cost a round: is_version_dir asks only
# whether a directory is NAMED after its own VERSION, and people name
# directories that way. A user's ~/Documents holding v1.2.3/ and v3.1/, each
# with a VERSION file reading its own name, satisfied it — so `install
# --download --kit ~/Documents` concluded the root was ours and pruned v3.1/
# away. Structure is what a user's directory does not accidentally have: it
# would need OUR CLI and OUR device installer inside it, under a release-tag
# name.
#
# It is also weaker than is_version_dir in the one direction §7 needs: a
# version directory that has lost its VERSION file is still unmistakably ours
# by shape, so a kit in that state is still recognised and still repairable.
#
# It must never gate a deletion. Every `rm -rf` in this file goes through
# is_version_dir, which is the conservative "we certainly named this" test —
# admitting a directory here only ever decides that the root as a whole is a
# kit worth operating on.
looks_like_our_tree() {
  [ -d "$1" ] || return 1
  [ ! -L "$1" ] || return 1
  valid_tag "${1##*/}" || return 1
  [ -f "$1/bin/redoku" ] && [ -f "$1/device/install.sh" ]
}

# kit_root_holds_only_ours <root> — does <root> contain nothing that is not
# this installer's? Used by guard 5's dangling-`current` arm, where the link
# target is gone and the name alone is too weak to decide on.
#
# "Ours" is `current` itself, a `.staging.*` leftover, and any child that
# is_version_dir or looks_like_our_tree recognises. In §6.2's repoint window
# and §7's dangling repair that is everything in the root; a directory of
# somebody's own holds a notes.txt and fails.
kit_root_holds_only_ours() {
  _krh_root=$1
  while IFS= read -r _krh_ent; do
    [ -n "$_krh_ent" ] || continue
    case ${_krh_ent##*/} in
      current | .staging.*) continue ;;
    esac
    is_version_dir "$_krh_ent" || looks_like_our_tree "$_krh_ent" || return 1
  done <<EOF
$(find "$_krh_root" -mindepth 1 -maxdepth 1 2>/dev/null)
EOF
  return 0
}

# kit_current_is_ours <root> — does <root>/current point at a version directory
# of this kit? The exact test guard 5's arm A applies to a RESOLVING symlink,
# factored out because fetch_kit needs the same answer before it replaces one.
kit_current_is_ours() {
  _kci=$(CDPATH='' cd -P -- "$1/current" 2>/dev/null && pwd -P) || return 1
  looks_like_our_tree "$_kci"
}

# kit_root_is_ours <root> — was <root> already a kit before this run touched
# it? Guard 5's two strict arms (A and B) and nothing else: no fresh-root
# allowance, because the question here is "may I delete things in here", and a
# root that is merely permitted to BECOME a kit has nothing in it that is ours.
kit_root_is_ours() {
  _kri_root=$1
  ! kit_current_is_ours "$_kri_root" || return 0
  while IFS= read -r _kri_dir; do
    [ -n "$_kri_dir" ] || continue
    if looks_like_our_tree "$_kri_dir"; then
      return 0
    fi
  done <<EOF
$(find "$_kri_root" -mindepth 1 -maxdepth 1 -type d 2>/dev/null)
EOF
  return 1
}

# self_tree_dir — the resolved directory this running CLI's own tree lives in,
# or empty. The one directory no deletion in this file may ever remove.
#
# Deleting it is survivable while the shell holds the file open, but it is
# never what anyone meant: it is the version you are standing in, and after a
# repair-and-prune it was also the only version left to roll back to.
self_tree_dir() {
  CDPATH='' cd -P -- "$REPO" 2>/dev/null && pwd -P
}

# prune_kit <kit-root> <keep> <keep-too> — delete every OTHER version
# directory under the kit root, keeping the version just installed and the
# one 'current' pointed at immediately before the repoint, so a rollback
# stays one symlink swap away (design doc §5.3).
#
# Three independent things have to hold before a child is removed, and the
# first is the one that matters: it must be a version directory by
# is_version_dir's name-equals-its-own-VERSION test, so anything else someone
# keeps in here — a note, a tarball, a source tree of their own that happens
# to carry a VERSION — is left alone. Then it must be a direct child of the
# base by string prefix. Then it must not be the tree we are executing from.
#
# "Keep one previous" is a promise about THIS KIT (§5.2, §5.3), and keeping it
# takes more than trusting <keep-too>. That argument names whatever `current`
# pointed at before the repoint, and on the repair paths §7 exists for it names
# nothing that is there: a dangling `current`, a missing one, or one made by
# hand with an absolute target. Every one of those left the kit with ZERO
# rollback targets, because a keep-too that matches no directory excludes no
# directory from the sweep.
#
# So the keep-too is VALIDATED here rather than trusted, and replaced when it
# names nothing. The replacement needs no version sorting, which is what makes
# it portable: §5.2 promises *a* rollback target, not the newest one — and the
# preference order below reflects which target is most useful rather than which
# is highest. First choice is the tree this run is executing from, because
# deleting that is never what anyone meant and it is the version the user
# demonstrably has in hand; failing that, the first surviving version directory
# `find` reports, because any rollback target beats none.
prune_kit() {
  _pk_base=$1
  _pk_keep=$2
  _pk_keep_too=$3
  # Resolved once, outside the loop, and compared against resolved children:
  # the base is already resolved by every caller, but proving that here costs
  # one cd and removes the need to trust it.
  _pk_self=$(self_tree_dir) || _pk_self=
  # A keep-too that arrived as a path rather than a bare tag — which a hand-made
  # `ln -s /abs/path/to/v0.1.0 current` produces — is reduced to the name the
  # loop below actually compares against. Reducing it can only ever make this
  # function keep MORE than it was asked to, never less, which is the safe
  # direction for the one function here that deletes.
  _pk_keep_too=${_pk_keep_too##*/}
  if [ -z "$_pk_keep_too" ] || ! is_version_dir "$_pk_base/$_pk_keep_too"; then
    _pk_keep_too=
    _pk_why=
    while IFS= read -r _pk_cand; do
      [ -n "$_pk_cand" ] || continue
      _pk_cname=$(basename "$_pk_cand")
      [ "$_pk_cname" != "$_pk_keep" ] || continue
      is_version_dir "$_pk_cand" || continue
      if [ -n "$_pk_self" ]; then
        _pk_cres=$(CDPATH='' cd -P -- "$_pk_cand" 2>/dev/null && pwd -P) || _pk_cres=
        if [ -n "$_pk_cres" ] && [ "$_pk_cres" = "$_pk_self" ]; then
          _pk_keep_too=$_pk_cname
          _pk_why="it is the version this command is running from"
          break
        fi
      fi
      if [ -z "$_pk_keep_too" ]; then
        _pk_keep_too=$_pk_cname
        _pk_why="it is the first version still here"
      fi
    done <<EOF
$(find "$_pk_base" -mindepth 1 -maxdepth 1 -type d 2>/dev/null)
EOF
    # Which of the two reasons applied is worth saying: one of them means the
    # kit kept the version you have in hand, the other that it kept whatever
    # was left. Both beat "no rollback target at all", which is what naming
    # neither used to produce.
    [ -z "$_pk_keep_too" ] || \
      say "  keeping $_pk_keep_too as the rollback target — 'current' named no usable version, and $_pk_why"
  fi
  while IFS= read -r _pk_dir; do
    [ -n "$_pk_dir" ] || continue
    _pk_name=$(basename "$_pk_dir")
    [ "$_pk_name" != "$_pk_keep" ] || continue
    [ -z "$_pk_keep_too" ] || [ "$_pk_name" != "$_pk_keep_too" ] || continue
    is_version_dir "$_pk_dir" || continue
    case $_pk_dir in
      "$_pk_base"/?*) ;;
      *) die "internal error: refusing to remove '$_pk_dir', which is not under $_pk_base" ;;
    esac
    # The safety rule, kept separate from the rollback promise above on
    # purpose: that one is about THIS KIT having a previous version, this one
    # is about never unlinking the tree whose bytes the shell is still reading.
    # They coincide when the CLI lives in the kit being repaired and diverge
    # when --kit or $REDOKU_HOME names a different one, which is exactly the
    # case keying the promise on this rule alone got wrong.
    #
    # Its one visible cost: run an OLD version's CLI directly against a kit
    # whose `current` is healthy, and the kit keeps three version directories
    # (the new one, the one-previous, and the one you ran from) where §5.3
    # pictures two. Harmless, and much better than the alternative.
    if [ -n "$_pk_self" ]; then
      _pk_res=$(CDPATH='' cd -P -- "$_pk_dir" 2>/dev/null && pwd -P) || _pk_res=
      if [ -n "$_pk_res" ] && [ "$_pk_res" = "$_pk_self" ]; then
        say "  keeping $_pk_name — it is the version this command is running from"
        continue
      fi
    fi
    say "  removing the superseded version $_pk_name"
    # A warning, not a die: the install itself has already succeeded by the
    # time this runs, and failing it over disk space nobody reclaimed would
    # undo a good install for a bad reason.
    rm -rf "$_pk_dir" || \
      say "  WARNING: couldn't remove $_pk_dir — delete it by hand to reclaim the space; the install itself is fine"
  done <<EOF
$(find "$_pk_base" -mindepth 1 -maxdepth 1 -type d 2>/dev/null)
EOF
}

# fetch_kit <layout> <base> — download, verify and unpack a released kit.
#
#   layout=kit       base=<kit root>  the tree lands at <base>/<tag>, and
#                                     <base>/current is repointed at it
#   layout=checkout  base=<repo>      the tree lands at
#                                     <base>/build/download/<tag>/redoku and
#                                     nothing else under <base> is touched —
#                                     a release binary must never be able to
#                                     pass for one you built (design doc §5.4)
#
# Sets $FETCH_TAG (the tag it ended up with), $FETCH_TREE (the unpacked tree,
# which is what the caller assigns to $KIT_ROOT) and $FETCH_BASE (<base>,
# fully resolved once it exists on disk — the PATH wrapper records that path
# literally, so it has to be the resolved one).
#
# A function with three eventual callers (kit-mode install, checkout-mode
# install, and 'upgrade' in a later task of this milestone), not inline
# cmd_install code: this is the security-relevant step of the whole feature,
# and a second copy of it free to drift from this one is precisely what
# design doc D7 exists to prevent.
fetch_kit() {
  _fk_layout=$1
  _fk_base=$2

  # Both preflight checks run before anything is fetched, created or written,
  # so a machine that cannot download or cannot verify never starts either.
  require_curl
  sha256_tool

  resolve_tag

  if [ "$_fk_layout" = kit ]; then
    # Created before the download so the path can be RESOLVED (the wrapper
    # written later records it literally, and the ownership test a later task
    # needs has to compare against something concrete). An empty directory is
    # the most a run that fails from here on can leave behind — no version
    # directory, no 'current', which is what §7's rows promise.
    mkdir -p "$_fk_base" || \
      die "could not create the kit directory $_fk_base — check the path and its permissions, or point somewhere else with --kit DIR"
    _fk_base=$(CDPATH='' cd -- "$_fk_base" && pwd -P) || \
      die "could not resolve the kit directory $_fk_base — check the path and its permissions"
  fi
  FETCH_BASE=$_fk_base

  # Captured HERE — before the download, before the unpack, before anything at
  # all is written into $_fk_base — because it asks whether this root was ours
  # BEFORE this run touched it, and the unpack itself makes any root look like
  # a kit. Measured the hard way: read at the repoint instead, it saw the
  # version directory this very run had just written and answered "ours" for a
  # user's ~/Documents, so the prune ran and deleted their v3.1/.
  _fk_was_ours=0
  if [ "$_fk_layout" = kit ]; then
    ! kit_root_is_ours "$_fk_base" || _fk_was_ours=1
  fi

  # design doc §6.3, consulted the FIRST of two times. 'install' is documented
  # as safe to re-run from any state, and bolting a network fetch onto it must
  # not weaken that: a version already on disk is reused rather than
  # re-fetched. This one only fires when steps 1-3 already knew the tag; on the
  # step-4 path $TAG is still empty here, and the second consultation — after
  # the tarball has been read — is what keeps the promise there. The repoint
  # below still runs either way: reusing a tree is not the same as leaving
  # 'current' where it was.
  _fk_reuse=0
  if [ -n "$TAG" ]; then
    _fk_dest=$(kit_dest "$_fk_layout" "$_fk_base" "$TAG")
    if kit_tree_is_complete "$_fk_dest"; then
      say "$TAG is already unpacked at $_fk_dest — reusing it, nothing to download"
      _fk_reuse=1
    fi
  fi

  if [ "$_fk_reuse" -eq 0 ]; then
    _fk_url=$(asset_url_dir)

    # Everything lands in a staging directory first and is renamed into place
    # at the very end (§6.2). That is what makes an interrupt, a full disk or
    # a truncated stream unable to leave <base>/<tag> half-populated: nothing
    # at the destination is written until a complete, checksum-verified tree
    # already exists beside it.
    #
    # "Beside it" is the operative word — see staging_parent's header for why
    # this is not $TMPDIR. The rename is only atomic within one filesystem.
    # In CHECKOUT mode this creates <repo>/build/download/ before the fetch,
    # where it used to appear only after a verified unpack — so a download
    # that fails now leaves an empty directory behind. Accepted rather than
    # unwound: it is inside build/, which is gitignored and is scratch space
    # by definition, and unwinding it correctly would mean an rmdir on every
    # one of the dozen `die` paths below, or a trap that has to remember
    # whether THIS run was the one that created it. Kit mode is unaffected —
    # the kit root is created before the download either way, which is the
    # state §7's "kit untouched" rows already describe.
    _fk_stage_parent=$(staging_parent "$_fk_layout" "$_fk_base")
    mkdir -p "$_fk_stage_parent" || \
      die "could not create $_fk_stage_parent to download into — check the path and its permissions"
    clean_stale_staging "$_fk_stage_parent"
    FETCH_TMP=$_fk_stage_parent/.staging.$$
    # Same belt-and-braces containment check the destination gets below: this
    # path is handed to rm -rf, by the traps and by the cleanup at the end.
    case $FETCH_TMP in
      "$_fk_base"/?*) ;;
      *) die "internal error: refusing to stage a download outside $_fk_base: '$FETCH_TMP'" ;;
    esac
    mkdir "$FETCH_TMP" || \
      die "could not create $FETCH_TMP to download into — if something is already there, remove it and try again"
    # EXIT alone just cleans up (the shell is on its way out anyway). INT,
    # HUP and TERM need traps that ALSO exit: a POSIX shell resumes the
    # script where it left off once a handler returns, and resuming with the
    # temp dir deleted out from under it is not what a signal handler is for.
    # 130/129/143 are the conventional 128+signal codes, so a caller's $?
    # still says which signal ended the run.
    trap 'rm -rf "$FETCH_TMP"' EXIT
    trap 'rm -rf "$FETCH_TMP"; exit 130' INT
    trap 'rm -rf "$FETCH_TMP"; exit 129' HUP
    trap 'rm -rf "$FETCH_TMP"; exit 143' TERM

    say "downloading $_fk_url/redoku-rm2.tar.gz"
    fetch_url "$_fk_url/redoku-rm2.tar.gz"        "$FETCH_TMP/redoku-rm2.tar.gz"
    fetch_url "$_fk_url/redoku-rm2.tar.gz.sha256" "$FETCH_TMP/redoku-rm2.tar.gz.sha256"

    _fk_actual=$(sha256_of "$FETCH_TMP/redoku-rm2.tar.gz")
    # The checksum file's first whitespace-separated field, read with the
    # shell's own `read` rather than cut or awk — one less external tool this
    # download path depends on. IFS is deliberately left at its default so a
    # tab-separated checksum file splits as readily as a space-separated one.
    #
    # `read` returns non-zero at EOF, which an empty or truncated file (or
    # one whose only line never reaches a second field) triggers — and under
    # set -eu that would otherwise end the run with NO output at all, right
    # after a successful download: the worst possible failure under §7's
    # "every message names its own fix" rule. `|| true` stops that being
    # fatal on its own; the emptiness check below is what actually says
    # something. _fk_expect is cleared first because `read` leaves a variable
    # untouched at EOF, and a stale value from an earlier fetch in the same
    # run would be compared as if it had just been read.
    _fk_expect=
    read -r _fk_expect _ < "$FETCH_TMP/redoku-rm2.tar.gz.sha256" || true
    [ -n "$_fk_expect" ] || \
      die "$_fk_url/redoku-rm2.tar.gz.sha256 is empty or unreadable — the download may have been truncated. Try the install again."
    _fk_expect=$(printf '%s' "$_fk_expect" | tr '[:upper:]' '[:lower:]')

    [ "$_fk_actual" = "$_fk_expect" ] || \
      die "checksum mismatch for $_fk_url/redoku-rm2.tar.gz
  expected: $_fk_expect
  got:      $_fk_actual
  Nothing was unpacked and $_fk_base is untouched. The download may be corrupt,
  or the release compromised — try again, and if it persists, do not install it."

    # A tarball is attacker-controlled input the moment a same-release
    # checksum is the only thing standing behind it (design doc §9 says as
    # much in as many words), and it is extracted as the user, into the
    # user's home directory. So every entry is listed FIRST and the archive
    # refused, whole, before extraction if any single one of them would write
    # outside the redoku/ tree §3.2 describes: a leading '/', a '..' anywhere
    # in the path, or any name not starting 'redoku/'. Same class of guard as
    # push_file's refusal to write outside $REMOTE_DIR — this one is not
    # theatre either.
    _fk_entries=$(tar -tzf "$FETCH_TMP/redoku-rm2.tar.gz") || \
      die "$_fk_url/redoku-rm2.tar.gz is not a readable gzipped tar archive (tar's own error is above) — the download may be corrupt. Try the install again."
    [ -n "$_fk_entries" ] || \
      die "$_fk_url/redoku-rm2.tar.gz is an empty archive — the download may be corrupt. Try the install again."
    _fk_bad=
    while IFS= read -r _fk_entry; do
      [ -n "$_fk_entry" ] || continue
      case $_fk_entry in
        # "redoku" on its own is the top-level directory as some tars name
        # it (mkkit's own emits "redoku/", with the slash, but that is a
        # property of the tar that packed it, not of the format) — accepted
        # for the same reason as "redoku/…": it cannot name anything outside
        # the directory this extracts into.
        redoku | redoku/*) ;;
        *) _fk_bad=$_fk_entry; break ;;
      esac
      case $_fk_entry in
        ../* | */../* | */..) _fk_bad=$_fk_entry; break ;;
      esac
    done <<EOF
$_fk_entries
EOF
    [ -z "$_fk_bad" ] || \
      die "refusing to unpack $_fk_url/redoku-rm2.tar.gz
  It contains the entry '$_fk_bad', which is outside the redoku/ tree every
  release kit consists of (design doc §3.2) — extracting it would write
  somewhere this installer never intends to go. NOTHING was extracted and
  $_fk_base is untouched. Re-download it; if it persists, do not install it and
  report it at https://github.com/QuirkQ/reDoku/issues"

    say "unpacking"
    tar -xzf "$FETCH_TMP/redoku-rm2.tar.gz" -C "$FETCH_TMP" || \
      die "could not unpack $_fk_url/redoku-rm2.tar.gz (tar's own error is above) — a full disk or a corrupt download. Nothing was installed; free some space or try again."
    # shellcheck disable=SC2015  # "A && B || C is not if-then-else, C may run
    # when A is true" — here it is exactly if-then-else, because B is a bare
    # `[ -f ]` with no side effects: C runs iff the directory is missing OR the
    # VERSION file is, which is the whole intent. The warning is about a B that
    # DOES something; keeping the `guard || die` shape also matches every other
    # precondition in this file. (Only shellcheck <= 0.9 raises this; 0.11 has
    # narrowed the heuristic. CI's runner image still ships 0.9.)
    [ -d "$FETCH_TMP/redoku" ] && [ -f "$FETCH_TMP/redoku/VERSION" ] || \
      die "$_fk_url/redoku-rm2.tar.gz unpacked with no redoku/VERSION inside it, so it is not a reDoku kit (design doc §3.2). Nothing was installed."

    # design doc §6.1's step 4, the fallback: the tag nothing else could
    # resolve is written inside the kit itself. file:// has no redirects at
    # all, so this is the path §8's offline tests take — and it also means a
    # change in GitHub's redirect shape costs one extra download instead of
    # breaking installs.
    if [ -z "$TAG" ]; then
      # `|| true`, not `|| TAG=`: `read` returns non-zero at EOF even when it
      # DID fill the variable, which is exactly what a VERSION file with no
      # trailing newline produces — clearing it there would turn a perfectly
      # readable tag into "this kit has no VERSION". valid_tag below is what
      # catches a genuinely unreadable one.
      read -r TAG < "$FETCH_TMP/redoku/VERSION" || true
      valid_tag "$TAG" || \
        die "the kit at $_fk_url/redoku-rm2.tar.gz carries a VERSION this installer
  cannot use as a directory name ('$TAG') — it may only hold letters, digits,
  '.', '_' and '-', and it may not be 'current' or begin '.staging.', which are
  names this installer owns inside a kit root. Nothing was unpacked and your kit
  is untouched. Pin a known-good release with REDOKU_VERSION=<tag> instead."
    fi
    _fk_dest=$(kit_dest "$_fk_layout" "$_fk_base" "$TAG")

    # Belt and braces, exactly as push_file does it: $TAG has already been
    # through valid_tag, but the rm -rf and the mv below are the two lines in
    # this script that can destroy something, so they check for themselves
    # that they are still inside <base>.
    case $_fk_dest in
      "$_fk_base"/?*) ;;
      *) die "internal error: refusing to unpack outside $_fk_base: '$_fk_dest'" ;;
    esac

    mkdir -p "$(dirname -- "$_fk_dest")" || \
      die "could not create $(dirname -- "$_fk_dest") — check the path and its permissions"
    if [ -e "$_fk_dest" ] || [ -L "$_fk_dest" ]; then
      # design doc §6.3, consulted the SECOND time — and on the step-4 path
      # this is the ONLY time, because $TAG was empty when the gate above ran.
      # Without it a complete existing tree was deleted and replaced by a
      # freshly downloaded copy of itself on every unpinned install, which is
      # §6.3's "install is documented as safe to re-run from any state; adding
      # a network fetch must not weaken that" not being kept on precisely the
      # path §8's offline tests exercise.
      #
      # The DOWNLOAD is not conditional and must not be made so: step 4 cannot
      # learn the tag without the bytes, and §6.2 already settles that trade —
      # "one wasted download, still correct". What the bytes buy is the tag;
      # once the tag says the tree already here is the one being installed,
      # and the tree passes the same gate, the bytes have done their job and
      # are discarded.
      if kit_tree_is_complete "$_fk_dest"; then
        say "$TAG is already unpacked at $_fk_dest — reusing it"
        say "  (the download was needed only to learn the tag, and is discarded)"
        _fk_reuse=1
      else
        # Now the message is true: this tree failed the gate a moment ago.
        # And it has to GO, not be merged with — `mv` onto an existing
        # directory moves the new tree INSIDE it rather than replacing it,
        # which is how you end up with <tag>/redoku/ and a kit whose every
        # path resolves one level short.
        say "replacing an incomplete earlier download at $_fk_dest"
        rm -rf "$_fk_dest" || \
          die "could not remove the incomplete earlier download at $_fk_dest — remove it by hand and try again"
      fi
    fi
    # Staging is a sibling of this destination, so this is a rename, not a
    # copy — see staging_parent. It can still fail (permissions, or a `build/`
    # somebody mounted separately), and if it fails partway the fix is not to
    # describe the wreckage but to remove it: a half-populated <tag>/ left
    # lying around is a tree a later run could adopt, and §7's preamble says
    # no failure leaves a partial install behind. The message then says what
    # is true, which is that there is nothing to clean up by hand.
    if [ "$_fk_reuse" -eq 0 ]; then
      mv "$FETCH_TMP/redoku" "$_fk_dest" || {
        rm -rf "$_fk_dest"
        die "could not move the unpacked kit into $_fk_dest — check permissions and free space.
  Anything that had begun to appear there has been removed and nothing else was
  changed, so there is no half-installed version to clean up. Try again."
      }
    fi

    # The staging directory has done its job. Drop it and its traps together,
    # here rather than at the end of this function, so that the repoint and
    # prune below run against a kit root holding nothing but version
    # directories and 'current' — and so a Ctrl-C from this point on behaves
    # exactly as it did before this function existed.
    rm -rf "$FETCH_TMP"
    FETCH_TMP=
    trap - EXIT INT HUP TERM
  fi

  if [ "$_fk_layout" = kit ]; then
    # Captured BEFORE the repoint: this is "the one current pointed at
    # immediately before", which prune_kit keeps so a rollback stays one
    # symlink swap away.
    #
    _fk_prev=
    if [ -L "$_fk_base/current" ]; then
      # A `current` that is a symlink but is NOT ours is somebody else's — the
      # canonical case being a Capistrano-style deploy root, where `current`
      # points at releases/<timestamp>. `rm -f` followed by `ln -s` replaced it
      # silently. `install --kit` reaches this line with no guard 5 in front of
      # it by design (see check_kit_root's `create` verb), so this is where
      # that shape has to be refused rather than at one caller.
      if [ -e "$_fk_base/current" ] && ! kit_current_is_ours "$_fk_base"; then
        die "$_fk_base/current is a symlink, but not one this installer wrote: it points
  at $(readlink "$_fk_base/current"), which is not a version directory of this kit.
  Refusing to replace it — that would take over a symlink somebody else is
  using. Install somewhere else with --kit DIR, or move it aside first."
      fi
      _fk_prev=$(readlink "$_fk_base/current") || _fk_prev=
    elif [ -e "$_fk_base/current" ]; then
      die "$_fk_base/current is not a symlink, so this installer won't replace it.
  It is meant to point at the version directory that is installed right now
  (current -> $TAG). Move it aside and try again, or install somewhere else
  with --kit DIR."
    fi
    # Unlink first, then link — NOT the `ln -s .current.new && mv -f
    # .current.new current` the design doc's §6.2 sketch suggests, and not
    # `ln -sfn` either.
    #
    # Measured, not assumed: with `current` already a symlink to a directory,
    # BSD `mv` RESOLVES the destination and moves the source INSIDE the
    # pointed-at directory. The second install of a different version left a
    # stray .current.new inside the OLD version directory, `current` still
    # said v0.1.0 while the run reported v0.2.0, and the prune below then
    # deleted the wrong one — silently, because every command had succeeded.
    # GNU mv needs -T to avoid the same thing and -T is GNU-only; `ln -sf`
    # without -n has the matching trap. That whole family of "what does this
    # do to an existing symlink-to-a-directory" differences is why this is
    # two plain commands instead of one clever one.
    #
    # The cost is that there is no atomic moment: between the rm and the ln,
    # `current` does not exist. That is the right trade here and only here —
    # a `current` that is missing or dangling is a state design doc §7 has an
    # answer for ("upgrade repairs it by installing latest"), whereas a
    # `current` pointing confidently at the wrong tree is not.
    rm -f "$_fk_base/current"
    ln -s "$TAG" "$_fk_base/current" || \
      die "could not point $_fk_base/current at $TAG — check permissions on $_fk_base"
    # Read it back rather than trusting that it worked. This is the exact
    # check that would have caught the mv bug above the moment it was
    # written, and it costs one readlink.
    [ "$(readlink "$_fk_base/current")" = "$TAG" ] || \
      die "internal error: $_fk_base/current should point at $TAG but points at '$(readlink "$_fk_base/current")' — the kit is unpacked and intact; re-run the install."
    say "$_fk_base/current now points at $TAG"
    # Only when 'current' actually MOVED. Re-running install on the version
    # already current changes nothing, and must not quietly delete the
    # one-back version a rollback depends on — 'install' is documented safe
    # to re-run from any state, and pruning on a no-op repoint would make the
    # second run destructive where the first was not.
    #
    # …and only in a root that was ALREADY ours before this run. That is the
    # guard that stops `install --download --kit ~/Documents` recursively
    # deleting a user's directories: prune_kit deletes every child that passes
    # is_version_dir, and in somebody's own directory those are their
    # directories, named v1.2.3/ and v3.1/ because that is how people name
    # things. `install` is the command that CREATES a kit root, so it cannot be
    # made to require one up front (check_kit_root's `create` verb says why) —
    # but a root this installer did not make is a root it has nothing to prune
    # in. A fresh root is not "ours" either and has nothing to prune, so the
    # only case this changes is the destructive one.
    if [ "$_fk_prev" != "$TAG" ] && [ "$_fk_was_ours" -eq 1 ]; then
      prune_kit "$_fk_base" "$TAG" "$_fk_prev"
    fi
  fi

  FETCH_TAG=$TAG
  FETCH_TREE=$_fk_dest
}

# ---- the PATH entry (design doc §5.3) ------------------------------------

# The one line that makes a wrapper ours. A function because 'uninstall
# --self' (a later task in this milestone) has to RECOGNISE exactly what this
# writes: a wrapper we can write but not recognise is a file we would either
# never remove, or remove without being sure it was ours. One definition, two
# readers — that is the shared part, and it is shared on purpose.
kit_exec_line() { # kit_exec_line <kit-root>
  printf 'exec "%s/current/bin/redoku" "$@"\n' "$1"
}

# is_our_wrapper <file> <kit-root> — does <file> exist and contain the exec
# line for THIS kit? That is the whole ownership test, and it is exact: a
# `redoku` some package manager put there, or one pointing at a different
# --kit, is never ours.
is_our_wrapper() {
  [ -f "$1" ] || return 1
  grep -qF "$(kit_exec_line "$2")" "$1" 2>/dev/null
}

# write_path_entry <bin-dir> <kit-root> — put a two-line `redoku` wrapper in
# <bin-dir>.
#
# Why a wrapper and NOT a symlink: $REPO at the top of this file is computed
# from "$(dirname -- "$0")/..", and invoked through a symlink at
# ~/.local/bin/redoku, $0 IS that symlink — so $REPO would become ~/.local
# and every path in this script would be wrong. The alternatives were a
# portable readlink-chase loop inside a safety-critical script (BSD readlink
# has no -f, so it is a loop, not a one-liner) or two lines outside it. Two
# lines outside it won.
#
# The path is written absolute and resolved, never as $HOME/.redoku: a --kit
# somewhere else has to work, and the ownership test above needs something
# concrete to compare against. It goes through <kit>/current and never
# through the version directory, so an upgrade leaves the wrapper untouched.
write_path_entry() {
  _wpe_dir=$1
  _wpe_kit=$2
  _wpe_file=$_wpe_dir/redoku

  # A `redoku` that is here but is not ours — one a package manager put
  # there, or a script of the user's own — is left exactly as it is.
  # Overwriting it would be the most user-hostile thing a piped installer
  # could do, and failing the whole install over it would be the second most,
  # so this reports it and carries on. -e misses a DANGLING symlink, which is
  # still very much someone else's file, hence the -L beside it.
  if { [ -e "$_wpe_file" ] || [ -L "$_wpe_file" ]; } && \
     ! is_our_wrapper "$_wpe_file" "$_wpe_kit"; then
    say "there is already a 'redoku' at $_wpe_file that this installer did not"
    say "  write, so it is being left exactly as it is — no PATH entry was made."
    say "  Put ours somewhere else with:  --bin-dir DIR"
    say "  Or skip the PATH entry entirely with:  --no-symlink"
    return 0
  fi

  mkdir -p "$_wpe_dir" || \
    die "could not create $_wpe_dir for the 'redoku' PATH entry — point somewhere writable with --bin-dir DIR, or skip it with --no-symlink"
  # Rewritten on EVERY kit-mode install, not only the first, so a moved bin
  # directory or a hand-edited wrapper self-heals and re-running stays
  # idempotent (§5.3). Written to a sibling and renamed over the old one: the
  # same never-a-half-written-file reasoning as the kit tree itself, and it
  # also means a wrapper that is executing RIGHT NOW gets replaced by a fresh
  # inode instead of being truncated under its own feet.
  # Each failure below removes the half-written sibling before it dies. A
  # leftover `redoku.new` in someone's ~/.local/bin is litter this installer
  # would never clean up again, and it is one tab-completion away from being
  # run by mistake.
  {
    printf '#!/bin/sh\n'
    kit_exec_line "$_wpe_kit"
  } > "$_wpe_file.new" || {
    rm -f "$_wpe_file.new"
    die "could not write $_wpe_file.new — check permissions on $_wpe_dir, or skip the PATH entry with --no-symlink"
  }
  # This one branch has no covering test, and cannot have one: `chmod` on a
  # file you own succeeds whatever the mode of the directory holding it, so
  # the only way to reach it is a filesystem that refuses chmod outright — and
  # an unwritable directory fails the redirection above first, never here.
  # Verified by the reviewer rather than assumed. The rm -f stays because the
  # branch existing at all is the reason a stray redoku.new would ever appear.
  chmod +x "$_wpe_file.new" || {
    rm -f "$_wpe_file.new"
    die "could not make $_wpe_file.new executable — check permissions on $_wpe_dir, or skip the PATH entry with --no-symlink"
  }
  mv -f "$_wpe_file.new" "$_wpe_file" || {
    rm -f "$_wpe_file.new"
    die "could not put the PATH entry at $_wpe_file — check permissions on $_wpe_dir, or skip it with --no-symlink"
  }
  say "PATH entry: $_wpe_file  ->  $_wpe_kit/current/bin/redoku"

  # ~/.local/bin over /usr/local/bin: no sudo, ever. A script you piped from
  # the internet asking for a root password is the prompt users should
  # refuse. The price is that the directory is not on every default PATH — so
  # say so, print the exact line to add, and never edit a shell rc file on
  # someone's behalf (§5.3). Compared with the colons on both sides so that a
  # bin dir which merely PREFIXES a real PATH entry doesn't read as a match.
  case ":${PATH:-}:" in
    *":$_wpe_dir:"*) ;;
    *)
      say "$_wpe_dir is not on your PATH — add this to your shell's rc file:"
      say "  export PATH=\"$_wpe_dir:\$PATH\"" ;;
  esac
}

# Decides kit mode and, with it, $KIT_DIR — design doc §5.2: "--kit alone
# decides it". Given (as the flag or as $REDOKU_HOME) means kit mode: unpack
# into that root, repoint current, write the PATH entry. Absent means
# checkout mode: a download lands in build/download/<tag>/ and nothing
# outside this directory is touched.
#
# The third case needs no flag at all. A CLI running from inside a kit
# (marker 2, $REPO/VERSION) already knows where its kit root is — one
# directory up from $REPO — which is what makes `redoku install` work
# unchanged when it was reached through ~/.local/bin. That derivation is only
# accepted when <parent>/current really does resolve to $REPO, because
# otherwise <parent> is not a kit root at all but merely wherever somebody
# unpacked a kit by hand, and a PATH wrapper pointing at a 'current' that
# does not exist would be worse than no wrapper.
#
# There is deliberately NO built-in ~/.redoku default here. That default
# lives in tools/install.sh, which passes --kit explicitly; a second copy of
# it here would turn a bare `install --download` in a checkout into a kit
# install of its own accord, which is the one thing "--kit alone decides it"
# rules out.
resolve_kit_mode() {
  if [ -n "$KIT_DIR" ]; then
    KIT_DIR=$(abs_path "$KIT_DIR")
  else
    [ "$IN_KIT" -eq 1 ] || return 0
    _rkm_parent=$(dirname -- "$REPO")
    _rkm_current=$(CDPATH='' cd -P -- "$_rkm_parent/current" 2>/dev/null && pwd -P) || _rkm_current=
    _rkm_repo=$(CDPATH='' cd -P -- "$REPO" && pwd -P) || _rkm_repo=
    [ -n "$_rkm_current" ] && [ "$_rkm_current" = "$_rkm_repo" ] || return 0
    KIT_DIR=$_rkm_parent
  fi
  # Resolved the moment the directory exists, so the string is the SAME
  # however this run reached kit mode. It has to be: the PATH wrapper records
  # this path literally and is recognised by comparing that literal back
  # (is_our_wrapper), so a download that resolved the root and a later plain
  # `install` from inside the kit that did not would each see the other's
  # wrapper as somebody else's file and refuse to touch it. Left as the plain
  # absolute form when the directory does not exist yet, because --dry-run
  # must not create it just to resolve it.
  if [ -d "$KIT_DIR" ]; then
    KIT_DIR=$(CDPATH='' cd -- "$KIT_DIR" && pwd -P) || \
      die "could not resolve the kit directory $KIT_DIR — check the path and its permissions, or point somewhere else with --kit DIR"
  fi
}

# The kit root 'upgrade' and 'uninstall --self' operate on — always a value,
# where resolve_kit_mode above deliberately leaves KIT_DIR empty to MEAN
# "checkout mode". These two commands have already refused a checkout by the
# time they call this, so the IN_KIT=0-with-empty-KIT_DIR combination the
# ~/.redoku default below exists to answer can no longer occur for either of
# them by the time they get here — every caller this file currently has
# refuses that combination itself first. The default is UNREACHABLE through
# any of them; it stays as a defensive backstop for some future caller that
# does not refuse the checkout case first, the way the docs still name it
# (§5.2), not because it applies to a caller that exists today. Removing it
# would only invite someone to reintroduce it under less care than it was
# written with.
#
# Its derivation cannot be resolve_kit_mode's, and getting the replacement
# wrong is how this function shipped a recursive delete of an arbitrary
# directory under $HOME. Both halves are worth stating.
#
# resolve_kit_mode requires <parent>/current to resolve back to $REPO before it
# will believe <parent> is a kit root. That is right for `install`, where
# writing a PATH wrapper through a 'current' that does not exist would be worse
# than writing none — but a 'current' that is missing or dangling is precisely
# the state §7 says `upgrade` REPAIRS, so applying it here would make the
# repair give up on the kit it is standing in and install a fresh one into
# ~/.redoku, leaving the broken kit exactly as broken.
#
# What it was replaced with the first time — marker 2 alone, "$REPO/VERSION
# exists, so my parent is a kit root" — is far too weak, because a kit tree
# unpacked BY HAND carries marker 2 too. `tar xzf redoku-rm2.tar.gz -C ~` gives
# ~/redoku/, and running its CLI then made $HOME a kit root: `current` and a
# version directory were created there, and prune_kit deleted every child of
# $HOME holding a VERSION file — ~/myapp and its contents, with no flag, no
# confirmation and exit 0. Demonstrated, not theorised.
#
# The test that is both strong enough and survives the repair case is
# is_version_dir's: a kit's version directories are named after their own
# VERSION, which a hand-unpacked `redoku/` is not, and which stays true when
# `current` is missing or dangling. When it fails there is no kit root to
# derive and this returns 1 with $KIT_ROOT_WHY explaining it, rather than
# guessing — the callers want different things from that answer, and one of
# them (`status`) must not die over it.
resolve_kit_root() {
  KIT_ROOT_WHY=
  if [ -n "$KIT_DIR" ]; then
    KIT_DIR=$(abs_path "$KIT_DIR")
  elif [ "$IN_KIT" -eq 1 ]; then
    # Resolved before the test and before the dirname: reached through the
    # PATH wrapper $REPO is <kit>/current, whose BASENAME is 'current' and
    # would fail is_version_dir on a perfectly good kit. Resolving turns it
    # into the version directory it points at, which is the thing being asked
    # about, and makes the parent the fully-resolved kit root the wrapper
    # itself records.
    _rkr_tree=$(CDPATH='' cd -P -- "$REPO" 2>/dev/null && pwd -P) || _rkr_tree=
    if [ -z "$_rkr_tree" ] || ! is_version_dir "$_rkr_tree"; then
      KIT_ROOT_WHY="the reDoku tree at ${_rkr_tree:-$REPO} is not part of an installed kit —
  it looks like one that was unpacked by hand. An installed kit holds its
  versions in directories named after their own VERSION (v0.3.0/, and so on)
  with a 'current' symlink beside them; this tree is not one of those, so there
  is no kit root here to repoint or prune, and guessing one would put this
  command to work in whatever directory happens to be its parent.
  Install it properly — that also puts a 'redoku' on your PATH:
    sh ${_rkr_tree:-$REPO}/bin/redoku install --download --kit ~/.redoku
  Or name the kit you meant with --kit DIR."
      return 1
    fi
    KIT_DIR=$(dirname -- "$_rkr_tree")
  else
    KIT_DIR=$HOME/.redoku
  fi
  # Resolved once it exists, for the same reason resolve_kit_mode resolves:
  # the PATH wrapper records this path literally and is_our_wrapper recognises
  # it by comparing that literal back, so an unresolved root would make our own
  # wrapper unrecognisable — and for 'uninstall --self' unrecognisable means
  # "somebody else's file", i.e. left behind forever.
  if [ -d "$KIT_DIR" ]; then
    KIT_DIR=$(CDPATH='' cd -- "$KIT_DIR" && pwd -P) || \
      die "could not resolve the kit directory $KIT_DIR — check the path and its permissions, or point somewhere else with --kit DIR"
  fi
}

# The --dry-run plan for `install --download`. This file's header promises
# that --dry-run always shows the plan without doing it, FOR EVERY COMMAND,
# and here "doing it" means fetching several megabytes and writing them under
# someone's home directory — so a dry run downloads nothing and writes
# nothing. It still runs the two preflight checks (they cost nothing and
# write nothing, and a plan that skipped them would promise an install this
# machine cannot actually perform) and resolves the tag as far as §6.1's
# steps 1-3 reach — never step 4, which IS a download.
#
# It stops here rather than carrying on into the device plan below, because
# every artifact path there would be a path inside a kit that has not arrived
# yet; where it names such a path it says so rather than implying otherwise.
plan_download() {
  require_curl
  sha256_tool
  resolve_tag

  # Every value below comes from the same helpers fetch_kit calls, so the plan
  # cannot describe one destination and the fetch produce another. The tag is
  # the only placeholder: with no REDOKU_VERSION, no stamp and no usable
  # redirect it is inside the tarball, and reading it means downloading it.
  fetch_target
  _pd_url=$(asset_url_dir)
  if [ -n "$TAG" ]; then
    _pd_tag=$TAG
  else
    _pd_tag='<tag>'
  fi
  _pd_dest=$(kit_dest "$FETCH_LAYOUT" "$FETCH_TARGET" "$_pd_tag")

  say "this will:"
  if [ -n "$TAG" ]; then
    say "  version : $TAG"
  else
    say "  version : the latest release — its tag is inside the tarball, and"
    say "            reading it means downloading it, which a dry run doesn't"
  fi
  say "  download: $_pd_url/redoku-rm2.tar.gz"
  say "            plus its .sha256, which has to match before anything unpacks"
  say "  unpack  : $_pd_dest/"
  if [ "$FETCH_LAYOUT" = kit ]; then
    say "  current : $FETCH_TARGET/current -> $_pd_tag"
    say "  prune   : older versions under $FETCH_TARGET, keeping the new one and"
    say "            the one 'current' points at now (a rollback stays one swap)"
    if [ "$NO_SYMLINK" -eq 1 ]; then
      say "  PATH    : nothing — --no-symlink"
    else
      say "  PATH    : $BIN_DIR/redoku, a two-line wrapper for $FETCH_TARGET/current/bin/redoku"
    fi
  else
    say "            never build/rm2/ or build/rm2fb/ — a release binary must"
    say "            not be able to pass for one you built"
    say "  PATH    : nothing — a PATH entry only comes with --kit (see --help)"
  fi
  say "  then    : install onto $TARGET out of that tree — the display server,"
  say "            the client library, rm2fbctl, the game, the prebuilt decoy"
  say "            and the watcher unit. NONE of those files are on this"
  say "            machine yet; they arrive with the download above."
  say "  action  : copy to $REMOTE_DIR/ and run the on-device installer"
  say "            (adds files only; any failure rolls back to stock)"
  say "  re-run  : safe any time — a version already unpacked is reused, not"
  say "            fetched again"
  say "[dry-run] stops here — nothing above actually ran"
}

# The --dry-run plan for `upgrade`, held to the same promise as
# plan_download's: a dry run downloads nothing and writes nothing, so the tag
# is only as resolved as §6.1's steps 1-3 could make it and the plan says so
# rather than implying it knows more. $TAG is read, not resolved again — its
# caller resolved it a moment ago, and resolving twice would mean two answers
# free to disagree about what the plan describes.
#
# A separate function from plan_download rather than a flag inside it: half of
# that plan is the DEVICE install that follows a download, and upgrade has no
# device stage at all. Sharing it would mean a plan whose every second line
# was conditional, describing a run that does not happen.
plan_upgrade() { # plan_upgrade <what-current-points-at-now, or empty> <state>
  # Costs nothing, writes nothing, and a plan that skipped them would promise
  # an upgrade this machine cannot actually perform.
  require_curl
  sha256_tool

  _pu_now=$1
  # The same four states cmd_upgrade computed, passed in rather than
  # re-derived: a plan that worked out for itself what it was upgrading FROM
  # would be free to disagree with the run it describes, and the "from" line
  # is the one line of this plan a user checks before saying yes.
  _pu_state=$2
  _pu_url=$(asset_url_dir)
  if [ -n "$TAG" ]; then
    _pu_tag=$TAG
  else
    _pu_tag='<tag>'
  fi

  say "this will:"
  case $_pu_state in
    ok)
      say "  from    : $_pu_now — what $KIT_DIR/current points at now" ;;
    missing)
      say "  from    : nothing — $KIT_DIR/current is missing, so this repairs it" ;;
    dangling)
      say "  from    : nothing usable — $KIT_DIR/current points at $_pu_now, which"
      say "            isn't there, so this repairs it" ;;
    foreign)
      say "  from    : nothing usable — $KIT_DIR/current points at $_pu_now, which"
      say "            is there but is not a version of this kit, so this repairs it" ;;
    *)
      say "  from    : nothing usable — $KIT_DIR/current points at $_pu_now, which"
      say "            is there but incomplete, so this repairs it" ;;
  esac
  if [ -n "$TAG" ]; then
    say "  to      : $_pu_tag"
  else
    say "  to      : the latest release — its tag is inside the tarball, and"
    say "            reading it means downloading it, which a dry run doesn't"
  fi
  say "  download: $_pu_url/redoku-rm2.tar.gz"
  say "            plus its .sha256, which has to match before anything unpacks"
  say "  unpack  : $(kit_dest kit "$KIT_DIR" "$_pu_tag")/"
  say "  current : $KIT_DIR/current -> $_pu_tag"
  say "  prune   : older versions under $KIT_DIR, keeping the new one and"
  say "            the one 'current' points at now (a rollback stays one swap)"
  if [ "$NO_SYMLINK" -eq 1 ]; then
    say "  PATH    : nothing — --no-symlink"
  else
    say "  PATH    : $BIN_DIR/redoku, a two-line wrapper for $KIT_DIR/current/bin/redoku"
  fi
  say "  device  : nothing at all — upgrade is host-side only. Run"
  say "            'redoku install' afterwards to put the new version on $TARGET."
  say "[dry-run] stops here — nothing above actually ran"
}

# The three files cmd_install pushes verbatim have to exist before any of the
# plan below can be believed. Asked of $KIT_ROOT, not $REPO: under the curl|sh
# bootstrap $REPO is a temp directory's parent and holds nothing at all, so as
# an opening line of cmd_install this fired before a single byte was fetched.
#
# A function rather than a block, because it has to run once per possible
# value of $KIT_ROOT — a download moves it, and the PROMPT path downloads
# after this has already run once against the checkout.
#
# Its message names a different fix for each case: inside a kit or a
# downloaded tree these files shipped with it (§3.2), so their absence means
# the download arrived incomplete; in a checkout it means what it always did.
require_device_files() {
  [ ! -f "$KIT_ROOT/device/install.sh" ] || \
    [ ! -f "$KIT_ROOT/device/uninstall.sh" ] || \
    [ ! -f "$KIT_ROOT/device/redoku-watcher.service" ] || return 0
  if in_kit_tree; then
    die "device/install.sh (or uninstall.sh, or redoku-watcher.service) not found in $KIT_ROOT — this kit is incomplete or corrupt, re-download it with:  $(refetch_hint)"
  fi
  die "device/install.sh (or uninstall.sh, or redoku-watcher.service) not found next to me — run bin/redoku from a reDoku checkout"
}

# design doc §5.4 — "a local build is never silently replaced" — for the one
# part of it a precedence rule cannot carry. Controller ruling 3 made the
# three device scripts come from $KIT_ROOT, so after a download in a checkout
# the scripts that go on the device are the RELEASED ones, not the ones the
# developer has been editing. That is correct (they belong to the same release
# as the binaries beside them, and mixing halves is how you get a kit that
# half-satisfies its own layout) — but it must not be SILENT, which is the
# word §5.4 actually uses. So: compare, and say so when they differ.
#
# Only ever has anything to say in a checkout, because it needs a $REPO/device
# to compare against; inside a kit there is nothing to have edited.
warn_device_scripts_replaced() {
  # Every other tool this file reaches for is checked before it is used, and
  # this one has a failure mode worse than being absent: with no `cmp`, the
  # comparison below fails for all three files and the NOTE fires saying they
  # differ when none of them do. A warning that goes off when nothing is wrong
  # is worse than no warning, so with no cmp there is no warning — and nothing
  # else in this run depends on it.
  command -v cmp >/dev/null 2>&1 || return 0
  _wdsr_differ=
  for _wdsr_f in install.sh uninstall.sh redoku-watcher.service; do
    [ -f "$REPO/device/$_wdsr_f" ] || continue
    [ -f "$KIT_ROOT/device/$_wdsr_f" ] || continue
    cmp -s "$REPO/device/$_wdsr_f" "$KIT_ROOT/device/$_wdsr_f" || \
      _wdsr_differ="$_wdsr_differ $_wdsr_f"
  done
  [ -n "$_wdsr_differ" ] || return 0
  say "NOTE: this checkout's device/ scripts differ from the downloaded kit's:"
  say "     $_wdsr_differ"
  say "     The RELEASED ones are what go on the device — they belong to the same"
  say "     release as the binaries beside them. To put YOUR versions on the"
  say "     device instead, build the binaries here and install from this"
  say "     checkout with neither --download nor --kit:"
  say "       make rm2fb && bin/redoku install"
}

# ---- removing the host kit (design doc §5.2's `uninstall --self`) --------
#
# This is the only code in this file that recursively deletes something the
# user did not hand it a path to, and it is aimed at a directory under their
# home. Design doc §10's D6 weighed printing the `rm` commands instead and
# rejected it — the kit writes a PATH entry OUTSIDE its own directory with no
# build step first, so it owes the user a precise, guarded removal — but the
# price of that decision is that every guard below has to be provably right,
# not merely present. Each one therefore says what makes the path it approves
# impossible to point somewhere else, and each has its own message.

# check_kit_root <root> <verb> — dies unless <root> is a directory this script
# may operate on as a kit root. <verb> is `remove` or `write`, and it does two
# things: it picks the voice every message speaks in, and it decides guard 5's
# strictness. Everything else is identical for both, which is the point — the
# two commands that touch a kit root are held to one standard by one function,
# and a second copy of these rules would be a second answer free to disagree.
#
# Called THREE times: by cmd_uninstall before it has touched the device (so a
# root that could never be removed is refused before anything happens rather
# than after the device has been returned to stock), by cmd_upgrade before it
# writes or prunes anything, and by remove_kit immediately before the first
# `rm -rf`, so the check cannot be skipped by a future caller that forgets it.
# Same belt-and-braces shape as push_file's refusal to write outside
# $REMOTE_DIR and fetch_kit's refusal to unpack outside its base.
#
# The verb exists because sharing the function was right and sharing the VOICE
# was not: every message here used to say the command was about to remove
# something, and `upgrade` removes nothing — so `upgrade --kit ~` refused with
# "refusing to remove your home directory", describing a command the user had
# not run. That is the same misdescribes-state defect this file treats as real
# wherever else it appears.
check_kit_root() {
  _crk_root=$1
  _crk_verb=$2
  case $_crk_verb in
    remove) _crk_act='remove'; _crk_asa='to remove' ;;
    write)  _crk_act='install into'; _crk_asa='to install into' ;;
    # `create` is `install`'s verb, and it takes guards 1-4 and stops. That is
    # a deliberate decision rather than a shortcut, and the reason is that
    # guard 5 asks "is this already a kit?" — a question `install --kit DIR` is
    # the command that makes true. Requiring it of the command that CREATES the
    # root is circular: it would refuse the first install into any new
    # directory, including a directory the user pre-made and put a note in,
    # which is an entirely reasonable thing to point --kit at.
    #
    # What guards 1-4 still buy is every "plausible typo" case guard 3 was
    # written for — `--kit ~`, `--kit /`, a relative path, a root that holds
    # this very script — and those are exactly the ones where the damage is
    # unbounded.
    #
    # The destructive half that guard 5 WOULD have covered for install is
    # closed where it actually happens instead: fetch_kit prunes only a root it
    # recognised as ours before this run, and refuses to replace a `current`
    # that is not ours. Guarding the deletion at the deletion is stronger than
    # guarding it at one of the three callers, which is the mistake that let
    # this reach install in the first place.
    create) _crk_act='install into'; _crk_asa='to install into' ;;
    *) die "internal error: unknown check_kit_root verb '$_crk_verb'" ;;
  esac

  # 1. Non-empty. `set -u` catches an UNSET variable and says nothing at all
  #    about an EMPTY one, so `rm -rf "$root"/*` with an empty root walks the
  #    filesystem root. This repo has already shipped a fix titled "close the
  #    empty-uuid rm -rf" for exactly that shape; an explicit check is what
  #    closes it, not errexit and not careful quoting.
  [ -n "$_crk_root" ] || \
    die "internal error: refusing to $_crk_act an empty kit path — say which kit with --kit DIR"

  # 2. Absolute. A relative path would be resolved against whatever directory
  #    the user happened to be standing in, so the SAME kit root would name
  #    different directories on two runs. resolve_kit_root makes it absolute;
  #    this is what proves it did.
  case $_crk_root in
    /*) ;;
    *)  die "internal error: refusing to $_crk_act the relative path '$_crk_root' — a kit root must be absolute" ;;
  esac

  # 3. Not the filesystem root, and not the home directory itself. Both are
  #    reachable by a plausible typo (`--kit /`, `--kit ~`) and neither can
  #    ever be a kit root: a kit root holds version directories, it is not the
  #    place they happen to live under. $HOME is compared both as written and
  #    as resolved, because ~ is a symlinked path on some systems and a guard
  #    that only catches one spelling of your home directory is not a guard.
  [ "$_crk_root" != / ] || \
    die "refusing $_crk_asa / as a kit root. Point --kit at the kit directory itself, e.g. --kit ~/.redoku"
  _crk_home=$(CDPATH='' cd -P -- "$HOME" 2>/dev/null && pwd -P) || _crk_home=$HOME
  { [ "$_crk_root" != "$HOME" ] && [ "$_crk_root" != "$_crk_home" ]; } || \
    die "refusing $_crk_asa your home directory ($_crk_root) as a kit root. A kit
  root is a directory of its own holding version directories and a 'current'
  symlink — point --kit at that, e.g. --kit ~/.redoku"

  # 4. Not an ancestor of this running script except in the one way a kit root
  #    legitimately is one. `uninstall --self` is normally run FROM inside the
  #    kit it is removing, so "the root contains me" cannot itself be the
  #    refusal — but it is only allowed to contain me the way a kit contains
  #    its versions, i.e. at <root>/<version>/bin/redoku, two components down
  #    or more. A root that is the directory I am running from, or that holds
  #    me directly, is something else that merely has this script inside it.
  _crk_self=$(CDPATH='' cd -P -- "$(dirname -- "$0")" 2>/dev/null && pwd -P) || _crk_self=
  if [ -n "$_crk_self" ]; then
    case $_crk_self in
      "$_crk_root"/?*/?*) ;;   # <root>/<version>/bin — the expected shape
      "$_crk_root" | "$_crk_root"/?*)
        die "refusing $_crk_asa $_crk_root: this script is running from $_crk_self,
  which sits directly in it rather than inside one of its version directories.
  That is not the shape of a kit root, so treating it as one would reach well
  beyond a kit. Name the real kit root with --kit DIR." ;;
    esac
  fi

  # 5. And it has to LOOK like a kit root, which is the guard that turns all of
  #    the above from "not obviously wrong" into "this is a kit". Every arm
  #    names something only this installer creates, and each is written to the
  #    shape of a real defect rather than to a general feeling of caution.
  #
  #    Arm A, the 'current' symlink. §5.3 gives us that name, but the NAME
  #    alone proves nothing: `current -> releases/<timestamp>` is the canonical
  #    Capistrano deploy root, so "has a symlink called current" admitted a
  #    user's deploy directory whole — `uninstall --self` deleted their symlink,
  #    and `upgrade` wrote a version directory into their project folder and
  #    called their directory "still there but incomplete". So the symlink has
  #    to point at one of OURS: a resolved target that passes is_version_dir,
  #    or — for the one window §6.2 documents, between the `rm -f` and the
  #    `ln -s` of a repoint, and for the dangling `current` §7 exists to
  #    repair — a target that at least reads like a tag we would have written.
  #    `releases/20240101120000` fails that on the slash alone.
  #
  #    Arm B, a direct child that passes is_version_dir — named after its own
  #    VERSION. "Holds a VERSION file" was the earlier test and it was far too
  #    loose: ~/Documents holding a source tree coolproject-1.2/ with a VERSION
  #    at its root passed all five guards and was recursively deleted, while
  #    the plan block called it "every version directory in it".
  #
  #    Arm C is `write` only, and the asymmetry is the point. An ABSENT or
  #    EMPTY root, or one holding nothing but our own `.staging.*` leftovers,
  #    is somewhere `upgrade` may legitimately create a kit — a fresh root, or
  #    one a SIGKILLed download left mid-flight — and refusing there would
  #    refuse §7's repair for a state that contains nothing of the user's at
  #    all. It is NOT somewhere `uninstall --self` may act: there is no kit to
  #    remove, and passing it made the closing `rmdir` delete an empty
  #    directory this installer never created, which is the line this milestone
  #    drew. `remove` therefore stops at arms A and B.
  # `create` stops here — see the verb table at the top for why guard 5 is the
  # wrong question to ask the command that creates the root.
  [ "$_crk_verb" != create ] || return 0

  _crk_looks=0
  if [ -L "$_crk_root/current" ]; then
    # FOUR states, not two, and collapsing them is how a directory of the
    # user's got back in after N3 was supposedly closed. `cd -P` failing does
    # NOT mean "dangling": it also fails for a symlink to a regular file, to a
    # directory that cannot be searched, and for a symlink loop. Treating all
    # of those as dangling downgraded the strong test (the target must be one
    # of ours) to the weak one, so `current -> active` in somebody's project
    # directory passed, and so did `current -> somefile` — which was then
    # reported as "dangling … which isn't there" about a file plainly there.
    #
    #   1. resolves to a directory of ours          -> a kit
    #   2. resolves to anything else                -> NOT a kit
    #   3. exists but cannot be resolved            -> NOT a kit
    #   4. genuinely dangling (the target is gone)  -> see below
    _crk_cres=$(CDPATH='' cd -P -- "$_crk_root/current" 2>/dev/null && pwd -P) || _crk_cres=
    if [ -n "$_crk_cres" ]; then
      looks_like_our_tree "$_crk_cres" && _crk_looks=1
    elif [ ! -e "$_crk_root/current" ]; then
      # No test pins THIS arm on its own, and that is recorded rather than
      # hidden: with kit_root_holds_only_ours below in place, every shape that
      # reaches it is already refused for the other reason — a link to a file
      # in the root makes that file a child which is not ours, and a link to
      # anything outside the root carries a slash and fails valid_tag. It is
      # kept because the two rules are independent and this one states the
      # intent: a link whose target EXISTS was never dangling, whatever cd -P
      # said. (cmd_upgrade needs the same distinction and is not redundant
      # there — see its `foreign` state, which is pinned.)
      #
      # State 4 only: -e follows the symlink, so it is false exactly when the
      # target is not there. This is §6.2's repoint window and §7's dangling
      # `current`, and the only evidence left is the name it was pointed at.
      #
      # Two things have to hold, because the name alone is weak. It has to read
      # like a tag WE would have written — `releases/20240101120000` fails on
      # the slash, and valid_tag also refuses 'current' itself, so a self-loop
      # cannot qualify — AND the root must hold nothing that is not ours. In a
      # real repoint window the root holds version directories and `.staging.*`
      # and nothing else; a project directory holds notes.txt.
      _crk_ctarget=$(readlink "$_crk_root/current") || _crk_ctarget=
      if valid_tag "$_crk_ctarget" && kit_root_holds_only_ours "$_crk_root"; then
        _crk_looks=1
      fi
    fi
  fi
  if [ "$_crk_looks" -eq 0 ]; then
    while IFS= read -r _crk_dir; do
      [ -n "$_crk_dir" ] || continue
      # is_version_dir OR looks_like_our_tree: the second is what lets §7's
      # "current missing" repair still work on a kit whose last version
      # directory has lost its VERSION file. That directory is unmistakably
      # ours by its shape, and admitting it here only decides that the ROOT is
      # a kit — it is never enough to get the directory deleted, because every
      # deletion goes through is_version_dir alone.
      if looks_like_our_tree "$_crk_dir"; then
        _crk_looks=1
        break
      fi
    done <<EOF
$(find "$_crk_root" -mindepth 1 -maxdepth 1 -type d 2>/dev/null)
EOF
  fi
  # An ABSENT root is nothing at all, and both surviving verbs may proceed:
  # `write` because that is the fresh-kit case, `remove` because there is
  # nothing there to remove and remove_kit says exactly that and returns. This
  # arm is what keeps `uninstall --self --kit <a path that is gone>` able to
  # return the DEVICE to stock — scoping arm C to `write` had taken that away
  # and stranded remove_kit's own "is not there" branch as dead code.
  [ "$_crk_looks" -eq 1 ] || [ -d "$_crk_root" ] || _crk_looks=1
  # Arm C, `write` only. An EMPTY root, or one holding nothing but our own
  # `.staging.*` leftovers, is somewhere `upgrade` may legitimately create a
  # kit — a fresh root, or one a SIGKILLed download left mid-flight — and
  # refusing there would refuse §7's repair for a state that contains nothing
  # of the user's. It is NOT somewhere `uninstall --self` may act: there is no
  # kit to remove, and passing it made the closing `rmdir` delete an empty
  # directory this installer never created. (The ABSENT case is not here; it is
  # handled for both verbs above, because "not there" and "there but empty" are
  # different states and only the second is a directory somebody made.)
  if [ "$_crk_looks" -eq 0 ] && [ "$_crk_verb" = write ] && [ -d "$_crk_root" ]; then
    _crk_looks=1
    while IFS= read -r _crk_ent; do
      [ -n "$_crk_ent" ] || continue
      case ${_crk_ent##*/} in
        .staging.*) ;;
        *) _crk_looks=0; break ;;
      esac
    done <<EOF
$(find "$_crk_root" -mindepth 1 -maxdepth 1 2>/dev/null)
EOF
  fi
  if [ "$_crk_looks" -eq 0 ]; then
    if [ "$_crk_verb" = write ]; then
      die "$_crk_root does not look like a reDoku kit, so nothing was installed into it.
  A kit root holds a 'current' symlink pointing at one of its own version
  directories, or version directories named after their own VERSION file
  (v0.3.0/ containing a VERSION that reads v0.3.0). This one holds neither, so
  what is in it belongs to you rather than to this installer, and 'upgrade' has
  no kit here to upgrade. To put a kit somewhere, install one — that creates the
  root and everything in it:
    redoku install --download --kit DIR
  If your kit is somewhere else, name it with --kit DIR."
    fi
    die "$_crk_root does not look like a reDoku kit, so nothing was removed.
  A kit root holds a 'current' symlink pointing at one of its own version
  directories, or version directories named after their own VERSION file
  (v0.3.0/ containing a VERSION that reads v0.3.0) — this one holds neither, so
  whatever is in it belongs to you rather than to this installer. If your kit is
  somewhere else, name it with --kit DIR; if you meant to delete this directory,
  delete it yourself."
  fi
}

# remove_kit <root> — delete the version directories, then 'current', then the
# root itself if nothing of the user's is left in it.
#
# What makes each `rm -rf` below provably right is not that the path was
# checked but that it was CONSTRUCTED: every path it is handed is a direct
# child of <root> as reported by `find`, re-tested against the "$root"/?*
# pattern, and required to pass is_version_dir — named after its own VERSION,
# which is a thing only this installer's own directories are. `find` is never
# told to follow symlinks, so 'current' is reported as a symlink and can never
# be the directory it points at; and any child that is not one of ours — a
# note, a tarball, a source tree that happens to carry a VERSION — fails the
# test and is left, which is also what stops the root itself from being
# removed.
remove_kit() {
  _rk_root=$1
  check_kit_root "$_rk_root" remove

  # Nothing to do, and saying so beats the alternative: the loop below would
  # find nothing, and the rmdir at the end would fail on a directory that was
  # never there and report it as a permissions problem.
  if [ ! -d "$_rk_root" ]; then
    say "  $_rk_root is not there — nothing to remove"
    return 0
  fi

  # Ours, and swept the same way a download sweeps them — a leftover from a
  # SIGKILLed fetch is not "something of the user's", and leaving it would
  # keep the root from being removed for no reason. clean_stale_staging skips
  # any whose pid is still alive, which is the right answer here too.
  clean_stale_staging "$_rk_root"

  while IFS= read -r _rk_dir; do
    [ -n "$_rk_dir" ] || continue
    is_version_dir "$_rk_dir" || continue
    case $_rk_dir in
      "$_rk_root"/?*) ;;
      *) die "internal error: refusing to remove '$_rk_dir', which is not under $_rk_root" ;;
    esac
    say "  removing $_rk_dir"
    # Unlinking the very file this shell is executing is safe and is the
    # normal case: `uninstall --self` runs from inside the kit it removes, and
    # POSIX keeps an open file's inode alive until the last descriptor closes,
    # so the script goes on being read from the fd the shell already holds.
    rm -rf "$_rk_dir" || \
      die "could not remove $_rk_dir — check its permissions and re-run 'redoku uninstall --self'. The device is already back to stock."
  done <<EOF
$(find "$_rk_root" -mindepth 1 -maxdepth 1 -type d 2>/dev/null)
EOF

  # -L, not -e: a DANGLING current is still ours and still has to go, and -e
  # says no about exactly that case.
  if [ -L "$_rk_root/current" ]; then
    say "  removing $_rk_root/current"
    rm -f "$_rk_root/current" || \
      die "could not remove $_rk_root/current — check permissions on $_rk_root"
  fi

  _rk_left=$(find "$_rk_root" -mindepth 1 -maxdepth 1 2>/dev/null | wc -l | tr -d '[:space:]')
  if [ "$_rk_left" = 0 ]; then
    # rmdir, never `rm -rf`: it can only succeed on a directory that is
    # already empty, so this last step cannot delete anything the loop above
    # decided to keep, whatever raced with it in between.
    rmdir "$_rk_root" || \
      die "removed everything inside $_rk_root but could not remove the directory itself — check its permissions and remove it by hand"
    say "  removed the kit root $_rk_root"
  else
    say "  $_rk_root has things in it this installer did not put there, so the"
    say "  directory itself was left alone. Still there:"
    while IFS= read -r _rk_keep; do
      [ -n "$_rk_keep" ] || continue
      say "    $_rk_keep"
    done <<EOF
$(find "$_rk_root" -mindepth 1 -maxdepth 1 2>/dev/null)
EOF
  fi
}

# ---- commands ----------------------------------------------------------

cmd_install() {
  resolve_kit_mode
  BIN_DIR=$(abs_path "$BIN_DIR")

  # THREE commands write and delete inside a kit root, not two. `install
  # --download --kit DIR` reaches the identical repoint and prune through
  # fetch_kit that `upgrade` does — design doc §5.3 says so outright, "pruning
  # to one previous version happens … by `upgrade` and by an `install
  # --download` of a different version alike" — and it reached them with none
  # of these guards in front of it, and before its own confirmation. A $HOME
  # holding v1.2.3/ and v3.1/ had both recursively deleted, and the run then
  # aborted at the confirm having installed nothing: the user was asked to
  # approve an action whose destructive half had already happened.
  #
  # Reachable from the shipped one-liner, too — tools/install.sh passes
  # --kit "$REDOKU_HOME", so exporting REDOKU_HOME=$HOME is all it took.
  [ -z "$KIT_DIR" ] || check_kit_root "$KIT_DIR" create

  if [ "$DOWNLOAD" -eq 1 ]; then
    if [ "$DRY" -eq 1 ]; then
      plan_download
      return 0
    fi
    # Through fetch_target, the same helper plan_download uses, so a dry run
    # and the real thing cannot disagree about where the tree lands.
    fetch_target
    fetch_kit "$FETCH_LAYOUT" "$FETCH_TARGET"
    if [ "$FETCH_LAYOUT" = kit ]; then
      # fetch_kit resolved it (mkdir + cd + pwd -P); take the resolved form
      # back, because the wrapper below records this path literally.
      KIT_DIR=$FETCH_BASE
    fi
    KIT_ROOT=$FETCH_TREE
  fi

  # The PATH entry is written BEFORE anything device-side is attempted, so a
  # device install that fails still leaves a working `redoku` on the PATH to
  # retry with. It is rewritten on every kit-mode install, download or not
  # (§5.3) — which is what makes a moved bin directory or a hand-edited
  # wrapper self-heal — but only where <kit>/current actually exists, since a
  # wrapper pointing through a 'current' that does not is worse than none.
  if [ -n "$KIT_DIR" ] && [ "$NO_SYMLINK" -eq 0 ] && [ -L "$KIT_DIR/current" ]; then
    if [ "$DRY" -eq 1 ]; then
      say "[dry-run] would write the PATH entry $BIN_DIR/redoku -> $KIT_DIR/current/bin/redoku"
    else
      write_path_entry "$BIN_DIR" "$KIT_DIR"
    fi
  fi

  # In this order: a kit that arrived incomplete is a hard failure and says so
  # first, and only a kit that IS complete is worth telling you differs from
  # what you have been editing.
  require_device_files
  warn_device_scripts_replaced

  build_decoy

  # Before the server hunt below, which may offer a download or a long
  # 'make rm2fb', so that the plan can report the game's state without a
  # wait in between.
  find_game || true

  # The message keeps naming the bare relative path in a checkout, where it
  # is unambiguous and always has; inside a kit or a downloaded tree
  # "build/rm2fb/dist" would be relative to a directory the user never typed,
  # so name it in full there.
  _art_where=${ARTIFACTS:-build/rm2fb/dist}
  if [ -z "$ARTIFACTS" ] && in_kit_tree; then
    _art_where=$KIT_ROOT/build/rm2fb/dist
  fi
  say "looking for the built armv7 binaries in $_art_where"
  SERVER=$(pick_artifact rm2fb_server_swtcon) || SERVER=
  CLIENT=$(pick_artifact librm2fb_client_swtcon.so) || CLIENT=
  if [ -z "$SERVER" ] || [ -z "$CLIENT" ]; then
    [ -z "$ARTIFACTS" ] || \
      die "no ARM builds of rm2fb_server_swtcon / librm2fb_client_swtcon.so under $ARTIFACTS"
    if in_kit_tree; then
      # These shipped prebuilt (§3.2), so their absence is not a build step
      # nobody ran — it is a download that arrived incomplete, and re-fetching
      # is the only thing that helps. Same wording, for the same reason, as
      # find_game's and build_decoy's kit-mode hints.
      die "no ARM builds of rm2fb_server_swtcon / librm2fb_client_swtcon.so under $KIT_ROOT/build/rm2fb/dist — this kit is incomplete or corrupt, re-download it with:  $(refetch_hint)"
    fi
    # Design doc §5.4 inverts what this prompt used to offer, and the
    # inversion IS the point of this milestone: Docker used to be the price
    # of entry, because the only answer to "not built yet" was a long
    # cross-compile. Downloading the released binaries is the default offer
    # now, and 'make rm2fb' the opt-in.
    say "not built yet — the released binaries can be downloaded instead"
    say "  they are the ones published for the latest release, NOT your working"
    say "  tree: nothing you have changed in this checkout would go on the device"
    say "  they land in build/download/<tag>/, never in build/rm2fb/dist/, so a"
    say "  released binary can't be mistaken for one you built"
    say "  (rather build them here? answer no, then run 'make rm2fb' — a Docker"
    say "  cross-compile whose first run clones the pinned rM2-stuff into tmp/)"
    confirm "Download the released binaries?"
    [ "$DRY" -eq 0 ] || die "dry-run: would download the released binaries into $REPO/build/download/ — re-run with --download to do it, or run 'make rm2fb' first"
    # Always the checkout layout, even if --kit was passed: this whole prompt
    # is the checkout row of §5.4 — its wording, its build/download/<tag>/
    # destination and its "not your working tree" promise. Somebody who wants
    # a kit install asks for one with --download.
    fetch_kit checkout "$REPO"
    KIT_ROOT=$FETCH_TREE
    # $KIT_ROOT has moved, so the two checks that ran against the checkout a
    # moment ago have to run again against what actually arrived — otherwise
    # an incomplete download is only noticed by push_file, three screens
    # later, with a message about a missing local file rather than a corrupt
    # kit, and a developer's edited device/install.sh is replaced by the
    # released one without a word.
    require_device_files
    warn_device_scripts_replaced
    # find_game ran against the checkout's own build/ tree a moment ago; now
    # that a kit is on disk, ask again — but ONLY if it found nothing there,
    # because a game you cross-built yourself must not be silently replaced
    # by a released one just because rm2fb happened not to be built too
    # (§5.4: a local build is never silently replaced). $DECOY_DIR is left
    # pointing into the checkout for the same reason and with no cost: this
    # checkout's own mkdecoy.rb already generated it, byte-for-byte what the
    # kit ships.
    [ -n "$GAME" ] || find_game || true
    SERVER=$(pick_artifact rm2fb_server_swtcon) || \
      die "the downloaded kit has no ARM build of rm2fb_server_swtcon in $KIT_ROOT/build/rm2fb/dist — it arrived incomplete or corrupt; try the install again"
    CLIENT=$(pick_artifact librm2fb_client_swtcon.so) || \
      die "the downloaded kit has no ARM build of librm2fb_client_swtcon.so in $KIT_ROOT/build/rm2fb/dist — it arrived incomplete or corrupt; try the install again"
  fi
  CTLBIN=$(pick_artifact rm2fbctl) || CTLBIN=

  say "this will:"
  say "  device : $TARGET"
  say "  server : $SERVER"
  say "  client : $CLIENT"
  if [ -n "$CTLBIN" ]; then
    say "  ctl    : $CTLBIN"
  else
    say "  ctl    : rm2fbctl not found — optional, continuing without it"
  fi
  if [ -n "$GAME" ]; then
    say "  game   : $GAME"
  else
    say "  game   : WARNING — skipped, everything else goes on alone:"
    say "           $GAME_WHY"
    say "           then re-run '$(cli_name) install' to stage the game"
  fi
  say "  decoy  : $DECOY_DIR ($DECOY_NOTE)"
  say "  watcher: $KIT_ROOT/device/redoku-watcher.service"
  say "  action : copy to $REMOTE_DIR/ and run the on-device installer"
  say "           (adds files only; any failure rolls back to stock)"
  say "  re-run : safe any time — the same files, the same end state"
  confirm "Install on the device?"

  connect
  say "copying files to $REMOTE_DIR"
  remote "mkdir -p $REMOTE_DIR/bin $REMOTE_DIR/lib $REMOTE_DIR/decoy"
  push_file "$SERVER" "$REMOTE_DIR/bin/rm2fb_server_swtcon"
  push_file "$CLIENT" "$REMOTE_DIR/lib/librm2fb_client_swtcon.so"
  [ -z "$CTLBIN" ] || push_file "$CTLBIN" "$REMOTE_DIR/bin/rm2fbctl"
  [ -z "$GAME" ] || push_file "$GAME" "$REMOTE_GAME"
  push_file "$KIT_ROOT/device/install.sh" "$REMOTE_DIR/install.sh"
  push_file "$KIT_ROOT/device/uninstall.sh" "$REMOTE_DIR/uninstall.sh"
  push_file "$KIT_ROOT/device/redoku-watcher.service" "$REMOTE_DIR/redoku-watcher.service"
  # watch.conf goes straight to its final home (device/install.sh reads it
  # there, and the running watcher does too — both by fixed, undisputed
  # path, not a staged copy an install step has to relocate).
  push_file "$DECOY_DIR/watch.conf" "$REMOTE_DIR/watch.conf"
  # The four sidecar files stay staged under $REMOTE_DIR/decoy/: their
  # real home is xochitl's own document store, which is outside
  # $REMOTE_DIR and therefore outside push_file's guard (on purpose — see
  # push_file's header) — device/install.sh, running as root, is what
  # copies them the rest of the way in and creates the <uuid>/ ink dir.
  for f in $DECOY_FILES; do
    push_file "$f" "$REMOTE_DIR/decoy/$(basename "$f")"
  done
  remote "chmod +x $REMOTE_DIR/bin/"'*'

  _force_arg=
  [ "$FORCE" -eq 0 ] || _force_arg=' --force'
  # Fix round 3, item 5: this used to promise "~30 s, includes a 15 s
  # verification wait" — stale since device/install.sh's own verification
  # became a bounded, per-service poll (fix round 2/3): the happy path is
  # still fast, but a slow-to-settle service can now add real minutes, and
  # there's no longer a single 15 s wait to point to.
  say "running the on-device installer (usually under a minute; a slow-to-settle service can add several minutes — its own output says what it's waiting on)"
  if remote "sh $REMOTE_DIR/install.sh$_force_arg"; then
    # remote() returns 0 unconditionally in dry-run, so without this guard
    # a dry run would print an outcome it never actually got.
    if [ "$DRY" -eq 1 ]; then
      say "[dry-run] stops here — nothing above actually ran"
    else
      say "all done — xochitl is running through the display server, decoy in the library"
      if [ -n "$GAME" ]; then
        say "  play it    : tap 'Sudoku' in the library, or $(cli_name) play"
      else
        # Not "make build, then bin/redoku play": inside a kit there is no
        # build to run and no bin/ to run it from, and the game's real fix was
        # already printed as $GAME_WHY in the plan above — by whichever of the
        # two it actually is. Pointing back at it beats printing a second,
        # checkout-only answer underneath it.
        say "  play it    : not yet — the game wasn't staged, so tapping the decoy"
        say "               launches nothing; fix that (see above) and re-run '$(cli_name) install'"
      fi
      say "  check it   : $(cli_name) status"
      say "  banished it: $(cli_name) uninstall"
    fi
  else
    die "the on-device installer failed and rolled the device back to stock
  (its output above says why; the device is safe and unchanged)"
  fi
}

# design doc §5.2: "fetch latest, repoint current, prune to one previous".
#
# Entirely host-side: it touches the kit under your home directory and the
# PATH entry, and never opens an ssh connection. Putting the new version on
# the device is 'install', which the closing message names.
cmd_upgrade() {
  # §5.4's last row. The marker is §5.1's marker 2 — a checkout has no
  # $REPO/VERSION beside it — and the advice is the one §5.4 gives verbatim.
  # An explicit kit root (--kit, or $REDOKU_HOME) is a different request and
  # is honoured: it names a kit outright rather than asking this CLI to
  # upgrade whatever it happens to be running from.
  if [ "$IN_KIT" -eq 0 ] && [ -z "$KIT_DIR" ]; then
    die "you're in a checkout: git pull && make build
  'redoku upgrade' fetches a released kit and repoints <kit>/current at it, and
  a checkout has neither of those. To put a released kit on this machine anyway,
  name its root:  bin/redoku install --download --kit ~/.redoku"
  fi

  resolve_kit_root || die "$KIT_ROOT_WHY"
  BIN_DIR=$(abs_path "$BIN_DIR")

  # The same guards `uninstall --self` runs, through the same function, and
  # before anything is written or pruned. Two commands write and delete inside
  # a kit root; holding one to a standard and not the other is how `upgrade`
  # came to create `current` and a version directory in a user's $HOME and
  # `rm -rf` a sibling source tree, in a directory `uninstall --self` refuses
  # by name. One function, two callers, one answer.
  check_kit_root "$KIT_DIR" write

  # What 'current' points at right now: the answer to "is there anything to
  # do?", and — through fetch_kit's own prune — the version kept as the
  # rollback target.
  #
  # Two different readings, because they answer two different questions.
  # `readlink` gives what the link SAYS, which is what a message about a
  # dangling link has to quote and the only thing left when nothing resolves.
  # `cd -P` gives what it POINTS AT, and that is what every test below wants:
  # string-joining readlink's output onto $KIT_DIR was wrong for a `current`
  # made by hand as `ln -s /abs/path/to/v0.1.0 current` — a plausible manual
  # rollback — which built "<kit>//abs/path/..." and then reported a complete
  # version directory sitting right there as "which isn't there".
  _up_now=
  _up_target=
  if [ -L "$KIT_DIR/current" ]; then
    _up_now=$(readlink "$KIT_DIR/current") || _up_now=
    _up_target=$(CDPATH='' cd -P -- "$KIT_DIR/current" 2>/dev/null && pwd -P) || _up_target=
  fi
  # The tag `current` names, for comparing against $TAG — the basename of what
  # it RESOLVES to, so an absolute link and a relative one to the same
  # directory give the same answer.
  _up_tag=
  [ -z "$_up_target" ] || _up_tag=${_up_target##*/}
  # Is that target actually a usable version tree? A dangling or half-deleted
  # one is not "the version you are on", it is the damage this command
  # repairs — and the closing message has to be able to tell those apart, or
  # a repair would report itself as "already up to date".
  #
  # $_up_state carries WHICH of the three states it is in, because "not usable"
  # covers two very different things and one message for both misdescribes one
  # of them: a target that is not there at all, and one that is there but
  # incomplete. Saying "which isn't there" about a directory still sitting on
  # disk is precisely the message-that-lies-about-state class this file treats
  # as a real defect.
  _up_ok=0
  _up_state=missing
  if [ -n "$_up_now" ]; then
    if [ -n "$_up_target" ]; then
      if kit_tree_is_complete "$_up_target"; then
        _up_ok=1
        _up_state=ok
      else
        _up_state=incomplete
      fi
    elif [ -e "$KIT_DIR/current" ]; then
      # `cd -P` failed but the target IS there, so this is not dangling: the
      # link points at a regular file, or at a directory that cannot be
      # searched. Collapsing this into "dangling" is the same mistake guard 5
      # made, and it produced the same lie — "which isn't there" printed about
      # a file sitting in plain view. Reachable through the --dry-run plan,
      # which runs before fetch_kit's own refusal would stop the real thing.
      _up_state=foreign
    else
      _up_state=dangling
    fi
  fi

  # §6.1's step 3 alone, first, and this ordering is about COST (§6.2's last
  # paragraph). The un-followed-redirect Location header is one HEAD request
  # and no bytes, so an "already on the latest" upgrade — much the commonest
  # outcome — costs no download at all. When it yields nothing (a file://
  # mirror has no redirects whatsoever; so does an offline machine) the answer
  # is only inside the tarball, and the fallback is to download and compare
  # VERSION: one wasted download, still correct.
  #
  # resolve_tag runs a second time inside fetch_kit below, which on the paths
  # that get that far means one extra HEAD request. That is the price of
  # fetch_kit resolving its own tag rather than trusting a caller to have done
  # it — the property that keeps every caller on §6.1's one ladder — and a
  # HEAD against a URL we are about to download several megabytes from is not
  # a cost worth restructuring for.
  WANT_LATEST=1
  resolve_tag
  if [ "$_up_ok" -eq 1 ] && [ -n "$TAG" ] && [ "$TAG" = "$_up_tag" ]; then
    say "already on $TAG — nothing to download"
    say "  ($KIT_DIR/current -> $TAG, and that is the latest this run could find)"
    return 0
  fi

  if [ "$DRY" -eq 1 ]; then
    plan_upgrade "$_up_now" "$_up_state"
    return 0
  fi

  # One function, three callers (§6.2 / D7). Everything the repoint and the
  # prune need is inside it already, and a second implementation of the
  # download-verify-unpack step free to drift from that one is exactly what
  # D7 exists to prevent.
  fetch_kit kit "$KIT_DIR"
  # fetch_kit resolved the root (mkdir + cd + pwd -P); take the resolved form
  # back, because write_path_entry records this path literally.
  KIT_DIR=$FETCH_BASE
  KIT_ROOT=$FETCH_TREE

  # The same self-healing rewrite a kit-mode install does (§5.3), and under
  # the same condition: only where <kit>/current actually exists, since a
  # wrapper pointing through a 'current' that does not is worse than none.
  if [ "$NO_SYMLINK" -eq 0 ] && [ -L "$KIT_DIR/current" ]; then
    write_path_entry "$BIN_DIR" "$KIT_DIR"
  fi

  if [ "$_up_ok" -eq 0 ]; then
    case $_up_state in
      missing)
        say "$KIT_DIR/current was missing — repaired: it now points at $FETCH_TAG" ;;
      dangling)
        say "$KIT_DIR/current was dangling (it pointed at $_up_now, which isn't there) — repaired: it now points at $FETCH_TAG" ;;
      foreign)
        say "$KIT_DIR/current pointed at $_up_now, which is there but is not a version of this kit — repaired: it now points at $FETCH_TAG" ;;
      *)
        say "$KIT_DIR/current pointed at $_up_now, which is still there but incomplete — repaired: it now points at $FETCH_TAG" ;;
    esac
  elif [ "$FETCH_TAG" = "$_up_tag" ]; then
    say "already on $FETCH_TAG — nothing changed"
  else
    say "upgraded: $_up_tag -> $FETCH_TAG"
  fi
  # REDOKU_VERSION pins upgrade exactly as it pins install (§5.2), which means
  # an 'upgrade' can legitimately install something OLDER than what was there.
  # Saying so is the difference between a surprising result and an explained
  # one.
  [ -z "${REDOKU_VERSION:-}" ] || \
    say "  (REDOKU_VERSION=$REDOKU_VERSION asked for that version specifically — unset it to take the latest)"
  say "  on the device: nothing changed — run 'redoku install' to put $FETCH_TAG on $TARGET"
}

cmd_play() {
  find_game || die "$GAME_WHY"
  connect

  # Just the game binary. 'install' stages the whole tree; re-running it here
  # would restart the display server and xochitl for a file neither of them
  # reads. One binary is all that changes while you work on the game, and
  # push_file unlinks before writing, so refreshing it while an older
  # instance is still running is safe.
  say "refreshing $REMOTE_GAME"
  remote "mkdir -p $REMOTE_DIR/bin"
  push_file "$GAME" "$REMOTE_GAME"
  remote "chmod +x $REMOTE_GAME"

  # The game cannot paint a single pixel without the server, so say so here
  # rather than let it fail with a socket error on the device.
  if [ "$DRY" -eq 0 ] && [ "$(remote \
       'systemctl is-active rm2fb.service 2>/dev/null || true' \
       | tr -d '[:space:]')" != active ]; then
    say "WARNING: rm2fb.service is not active — the game cannot draw."
    say "         Install the display server first:  $(cli_name) install"
  fi

  if [ -z "$PLAY_SECS" ]; then
    say "starting the game — the Quit button (or Ctrl-C) gives the screen back"
    if [ "$DRY" -eq 1 ]; then
      printf '==> [dry-run] ssh -t %s -- %s\n' "$TARGET" "$REMOTE_GAME" >&2
      return 0
    fi
    # -t asks for a real tty so Ctrl-C arrives as SIGINT at the game, which
    # quits cleanly, instead of just dropping the ssh session behind its back.
    _rc=0
    ssh_run -t "$TARGET" "$REMOTE_GAME" || _rc=$?
    [ "$_rc" -eq 0 ] || die "the game exited $_rc — its output above says why"
    say "done — the screen is back to xochitl"
    return 0
  fi

  # No tty this time: nothing is watching. No 'timeout' either — the device's
  # BusyBox has no such applet — so a background sleep TERMs the game and
  # 'wait' reports how it went. 143 is 128+SIGTERM, meaning the signal killed
  # it outright; redoku handles SIGTERM and exits 0 instead, so a timed run
  # ending either way is a run that ended when we asked it to.
  #
  # SIGCONT follows the TERM, and a SIGKILL follows both $KILL_GRACE seconds
  # later, because a signal sent to a STOPPED process just sits there
  # pending: the display server stops a client it demotes, and such a game
  # never runs to handle its SIGTERM at all, so the deadline this option
  # promises was not a deadline. CONT lets it wake up and quit cleanly
  # (giving the panel back on its own terms); KILL is the guarantee, needs no
  # CONT of its own — a stopped process dies of it regardless — and surfaces
  # as exit 137, which the case below reports for what it is.
  #
  # The grace has to outlast the display connection's own receive timeout,
  # not just a scheduler hiccup: RM2_RECV_TIMEOUT_SEC is 10 s
  # (mrbgems/mruby-rm2/src/display.c), so a game blocked in a read against a
  # server that has stopped acking cannot even look at its SIGTERM until that
  # expires. At 5 s the KILL landed first and the 137 message described
  # something that had not happened — an ignored signal or a stopped process —
  # when the truth was a socket read that would have returned. 15 s is that
  # timeout plus slack; the common case sits in poll(), which returns on
  # EINTR, and exits 0 well inside a second either way.
  #
  # The watchdog's >/dev/null 2>&1 is what makes an early death report early.
  # 'kill $sp' kills the subshell, not the sleep it forked, and an orphaned
  # sleep holding the remote stdout keeps the ssh channel from reaching EOF —
  # so a game that dies in 0.2 s would not be reported for the full N
  # seconds. With its own stdio detached, the orphan holds nothing. (BusyBox
  # 1.36 runs 'sleep' in-process and so dies with the subshell, hiding this;
  # dash and friends leave the orphan, and the device's applet set is a
  # build-time choice we should not lean on.)
  #
  # Ctrl-C here kills ssh, not the game: the watchdog is deliberately left
  # alive so it still TERMs the game at second N, but the panel stays taken
  # until then.
  #
  # 'setsid' is what keeps the watchdog out of the game's process group, and
  # it is load-bearing: the display server pauses a client it demotes with
  # kill(-getpgid(pid), SIGSTOP) — the WHOLE group. In a non-interactive
  # 'sh -c' job control is off, so without it the game, the watchdog subshell
  # and the waiting shell all share the group sshd made, and anything taking
  # front during the window (xochitl restarting, another rm2fb client, a
  # stray 'rm2fbctl switch') freezes the watchdog along with the game: N
  # seconds becomes unbounded, ssh never sees EOF, and the panel stays taken.
  # In its own session the watchdog cannot be stopped by the game's demotion.
  #
  # $! is still the game: setsid() only fails for a process-group leader, and
  # a background child of this shell is not one, so setsid execs in place
  # rather than forking. This is not the setsid PLAN.md §5 refuses — that one
  # is about the game keeping its controlling terminal so Ctrl-C reaches it
  # as SIGINT, which is the interactive path above; this path has no tty at
  # all.
  say "running the game for ${PLAY_SECS}s, unattended"
  _watchdog="sleep $PLAY_SECS; kill -TERM \$rp 2>/dev/null; kill -CONT \$rp 2>/dev/null; sleep $KILL_GRACE; kill -KILL \$rp 2>/dev/null"
  _timed="setsid $REMOTE_GAME & rp=\$!; ($_watchdog) >/dev/null 2>&1 & sp=\$!; wait \$rp; rc=\$?; kill \$sp 2>/dev/null; exit \$rc"
  _rc=0
  remote "$_timed" || _rc=$?
  # remote() returns 0 unconditionally in dry-run, so without this the case
  # below would announce an outcome from a run that never happened — the trap
  # wave B fixed for 'install', in the one other place that had it.
  if [ "$DRY" -eq 1 ]; then
    say "[dry-run] stops here — nothing above actually ran"
    return 0
  fi
  case $_rc in
    0|143) say "the timed run ended cleanly (exit $_rc)" ;;
    137)   die "the game was SIGKILLed (exit 137)
  It did not stop for SIGTERM within ${KILL_GRACE}s of the ${PLAY_SECS}s deadline — it
  was ignoring the signal, the display server had it stopped and even SIGCONT
  did not get it to quit, or it was stuck in a display read for longer than the
  connection's own 10 s receive timeout. The panel is back either way;
  '$(cli_name) status' says what is running now." ;;
    *)     die "the game exited $_rc — its output above says why" ;;
  esac
}

cmd_uninstall() {
  # The same two answers require_device_files gives, for the same reason and in
  # the same shape: this file is reached two ways, and "go and find a checkout"
  # is wrong advice to somebody running from a kit — they may well not have
  # one, and what has actually happened is that their kit arrived incomplete.
  # The name the user typed is not the defect here; the sentence is, so
  # cli_name() alone would only have made it read "run redoku from a reDoku
  # checkout".
  if [ ! -f "$REPO/device/uninstall.sh" ]; then
    if in_kit_tree; then
      die "device/uninstall.sh not found in $REPO — this kit is incomplete or corrupt, re-download it with:  $(refetch_hint)"
    fi
    die "device/uninstall.sh not found next to me — run $(cli_name) from a reDoku checkout"
  fi

  # Everything --self needs to know is worked out HERE, before the plan block
  # and therefore before the confirmation, because §5.3's rule is that nothing
  # is deleted that was not named in the plan — which means the plan has to
  # name it by the same absolute paths the deletion will use, not by a
  # description of how they will later be derived.
  _un_wrapper=
  _un_foreign=
  if [ "$SELF" -eq 1 ]; then
    # There is no kit in a checkout, so there is nothing for --self to do and
    # nothing it could remove without guessing. Same marker (§5.1's marker 2)
    # and the same "an explicit kit root is a different request" carve-out as
    # 'upgrade'.
    if [ "$IN_KIT" -eq 0 ] && [ -z "$KIT_DIR" ]; then
      die "--self removes a released kit, and you're in a checkout — there is no kit here.
  Return the device to stock with:  bin/redoku uninstall
  Then delete the checkout yourself; nothing outside it was installed.
  (Removing a kit somewhere else? Name it:  bin/redoku uninstall --self --kit DIR)"
    fi
    resolve_kit_root || die "$KIT_ROOT_WHY"
    BIN_DIR=$(abs_path "$BIN_DIR")
    # Refused before the device is touched, not after it has been returned to
    # stock — the deletion re-checks for itself immediately before its first
    # rm -rf, but a root that could never pass has no business getting as far
    # as an ssh connection.
    check_kit_root "$KIT_DIR" remove
    # §5.3's ownership test, through the one helper that knows it: the file is
    # ours only if it holds the exec line for THIS kit. Anything else is
    # somebody's own `redoku` — a package manager's, a script of their own —
    # and is named in the plan as a thing that will be LEFT, so that the plan
    # and the outcome agree either way.
    if is_our_wrapper "$BIN_DIR/redoku" "$KIT_DIR"; then
      _un_wrapper=$BIN_DIR/redoku
    elif [ -e "$BIN_DIR/redoku" ] || [ -L "$BIN_DIR/redoku" ]; then
      _un_foreign=$BIN_DIR/redoku
    fi
  fi

  say "this returns the device to stock (idempotent, safe on partial installs)"
  say "  the decoy 'Sudoku' document and its watcher always come out —"
  say "  a document that launches nothing is worse than no document at all"
  if [ "$PURGE" -eq 1 ]; then
    say "  --purge: ALSO deletes $REMOTE_DIR entirely (binaries, scripts, everything)"
    say "           — that is on the DEVICE, and nothing on this machine"
  fi
  if [ "$SELF" -eq 1 ]; then
    say "  --self: and then, on THIS machine (not the device), deletes:"
    # Enumerated, not described. "every version directory in it" is a summary,
    # and a summary is not a contract: it read as reassuring on a root where
    # what would actually go was somebody's source tree. remove_kit deletes
    # exactly the children that pass is_version_dir, so the plan lists exactly
    # those children, by the absolute path they will be deleted under — you
    # can read the list and stop the run if a name on it surprises you.
    while IFS= read -r _un_v; do
      [ -n "$_un_v" ] || continue
      is_version_dir "$_un_v" || continue
      say "            $_un_v"
    done <<EOF
$(find "$KIT_DIR" -mindepth 1 -maxdepth 1 -type d 2>/dev/null)
EOF
    [ ! -L "$KIT_DIR/current" ] || say "            $KIT_DIR/current"
    say "            $KIT_DIR itself, if nothing of yours is left in it"
    if [ -n "$_un_wrapper" ]; then
      say "            $_un_wrapper"
      say "            — the PATH entry this installer wrote for that kit"
    elif [ -n "$_un_foreign" ]; then
      say "          the 'redoku' at $_un_foreign is NOT ours (it doesn't exec"
      say "          this kit), so it is left exactly as it is."
    else
      say "          no PATH entry to remove — there is no 'redoku' at $BIN_DIR"
    fi
    say "          Nothing else on this machine is touched. The device comes"
    say "          first: if it can't be returned to stock, none of the above"
    say "          happens and you can retry."
  fi
  confirm "Return the device to stock?"

  # The device stage is all of what follows, and it must finish before a
  # single host-side file is deleted — deleting the kit first would delete
  # $REPO/device/uninstall.sh, the very script this stage pushes. Both
  # connect() and remote()'s failures go through die(), which exits the
  # process, so there is no "after the failure" left in which to explain that
  # the kit is still here: an EXIT trap is the only place the sentence can be
  # printed from. Armed after the confirmation (an abort has its own message
  # and needs no second one) and disarmed the moment the stage succeeds.
  if [ "$SELF" -eq 1 ]; then
    trap 'printf "==> the host kit at %s was NOT removed — the device did not get back to stock, so nothing on this machine was touched. Fix that and re-run: redoku uninstall --self\n" "$KIT_DIR" >&2' EXIT
  fi

  connect
  say "copying the uninstaller"
  remote "mkdir -p $REMOTE_DIR"
  push_file "$REPO/device/uninstall.sh" "$REMOTE_DIR/uninstall.sh"

  _purge_arg=
  [ "$PURGE" -eq 0 ] || _purge_arg=' --purge'
  say "running the on-device uninstaller"
  remote "sh $REMOTE_DIR/uninstall.sh$_purge_arg"
  say "done — the device is back to stock"
  [ "$SELF" -eq 0 ] || trap - EXIT

  [ "$SELF" -eq 1 ] || return 0

  # A dry run has shown the plan; doing it is what it must not do. This is the
  # one command in this file where "changes nothing" means "deletes nothing",
  # so the guard is here rather than inside remove_kit, where a future caller
  # could reach the deletion around it.
  if [ "$DRY" -eq 1 ]; then
    say "[dry-run] stops here — $KIT_DIR is still there and nothing was removed"
    return 0
  fi

  # The wrapper goes FIRST. If the kit went first and this then failed, the
  # PATH would keep a 'redoku' that execs a directory which no longer exists —
  # a command that fails with a message about a missing file rather than one
  # saying it was uninstalled. This order can only leave the opposite, milder
  # state: a kit with no PATH entry, which the kit's own CLI can still finish
  # removing.
  if [ -n "$_un_wrapper" ]; then
    say "removing the PATH entry $_un_wrapper"
    rm -f "$_un_wrapper" || \
      die "could not remove $_un_wrapper — check permissions on $BIN_DIR and remove it by hand. The device is back to stock and the kit is still at $KIT_DIR."
  elif [ -n "$_un_foreign" ]; then
    say "leaving the 'redoku' at $_un_foreign alone — this installer did not write it"
  fi

  say "removing the kit at $KIT_DIR"
  remove_kit "$KIT_DIR"
  say "done — the device is back to stock and this machine has no reDoku kit left"
  say "  reinstall any time with:"
  say "    curl -fsSL https://github.com/QuirkQ/reDoku/releases/latest/download/install.sh | sh"
}

# The one line of `status` that is about THIS machine rather than the device
# (design doc §5.2). Printed locally and never smuggled into the remote
# script: the device has no idea which kit on your laptop drove the install,
# and a line that pretended otherwise would be reporting a value it made up.
#
# Padded to the same width as the device's own lines ("firmware ", "installed",
# "rm2fb    " …) so the whole block stays one aligned table, and printed with
# printf rather than say() for the same reason — say()'s "==> " prefix belongs
# to progress messages, not to the table.
#
# The path is abbreviated to ~ when it is under $HOME. That is display only:
# nothing parses this line, and every path this file feeds to a command is the
# absolute, resolved one.
kit_status_line() {
  if [ "$IN_KIT" -eq 0 ] && [ -z "$KIT_DIR" ]; then
    # An empty value here would be the least useful thing to print. Say what
    # is actually true instead: this is a checkout, so there is no kit, and
    # $KIT_VERSION — §5.1's marker 1 — says whether these bytes were released
    # or are a working copy.
    printf 'kit      : none — running from %s (KIT_VERSION=%s)\n' "$REPO" "$KIT_VERSION"
    return 0
  fi
  # A tree that carries marker 2 but is not part of an installed kit — one
  # unpacked by hand — has no kit root, and this line must say so rather than
  # invent one. It used to advise "repair it with: redoku upgrade" here, which
  # was an instruction to run the command that would then treat the parent
  # directory as a kit root; that is fixed in resolve_kit_root, and this says
  # what is actually true instead. `status` never dies over it, which is why
  # resolve_kit_root reports this by return code rather than by die().
  if ! resolve_kit_root; then
    printf 'kit      : none — %s was unpacked by hand, not installed\n' "$REPO"
    # The FULL path, matching resolve_kit_root's refusal for this identical
    # state and for its reason: in a hand-unpacked tree there is no kit, so
    # there is no PATH wrapper either, and neither `redoku` nor `bin/redoku`
    # names anything the reader can run. The one spelling that works is the
    # one they already used to get here.
    printf '           install it with: sh %s/bin/redoku install --download --kit ~/.redoku\n' "$REPO"
    return 0
  fi
  _ksl_shown=$KIT_DIR/current
  # Both spellings of the home directory, because resolve_kit_root resolves
  # the kit root (cd + pwd -P) while $HOME stays exactly as the environment
  # wrote it — and on a machine where /var is a symlink to /private/var, or
  # where anyone's home is reached through one, those two strings differ and a
  # test against $HOME alone silently never abbreviates.
  _ksl_home=$(CDPATH='' cd -P -- "$HOME" 2>/dev/null && pwd -P) || _ksl_home=$HOME
  case $_ksl_shown in
    "$HOME"/*)      _ksl_rest=${_ksl_shown#"$HOME"};      _ksl_shown="~$_ksl_rest" ;;
    "$_ksl_home"/*) _ksl_rest=${_ksl_shown#"$_ksl_home"}; _ksl_shown="~$_ksl_rest" ;;
  esac
  _ksl_ver=
  if [ -f "$KIT_DIR/current/VERSION" ]; then
    # `|| true` for the same reason fetch_kit's read of VERSION has it: `read`
    # returns non-zero at EOF even when it DID fill the variable, which a
    # VERSION file with no trailing newline produces.
    read -r _ksl_ver < "$KIT_DIR/current/VERSION" || true
  fi
  if [ -n "$_ksl_ver" ]; then
    printf 'kit      : %s (%s)\n' "$_ksl_ver" "$_ksl_shown"
  else
    printf 'kit      : %s — broken, repair it with: redoku upgrade\n' "$_ksl_shown"
  fi
}

cmd_status() {
  connect
  # shellcheck disable=SC2016  # "expressions don't expand in single quotes"
  # — that is the whole design. Everything in this string is evaluated by
  # the DEVICE's shell, not this one: single quotes are what carry the
  # $(...) and the \n through ssh intact. Double quotes would run the
  # systemctl calls on the host and ship their answers to the tablet.
  remote 'printf "firmware : %s\n" "$(sed -n "s/^IMG_VERSION=//p" /etc/os-release | tr -d \")"
if [ -f /etc/systemd/system/rm2fb.service ]; then printf "installed: yes\n"; else printf "installed: no\n"; fi
printf "rm2fb    : %s\n" "$(systemctl is-active rm2fb.service 2>/dev/null || true)"
printf "xochitl  : %s\n" "$(systemctl is-active xochitl.service 2>/dev/null || true)"
if [ -S /var/run/rm2fb.sock ]; then printf "socket   : present\n"; else printf "socket   : absent\n"; fi
if [ -f /home/root/redoku/preload.env ]; then printf "preload  : armed (xochitl draws through rm2fb)\n"; else printf "preload  : disarmed (xochitl is stock)\n"; fi'
  # After the remote block, so the host-side line joins the end of the same
  # aligned table rather than being separated from it by connect()'s progress
  # messages.
  kit_status_line
}

cmd_shell() {
  connect
  [ "$DRY" -eq 1 ] && return 0
  ssh_run "$TARGET"
}

case $CMD in
  install)   cmd_install ;;
  upgrade)   cmd_upgrade ;;
  play)      cmd_play ;;
  uninstall) cmd_uninstall ;;
  status)    cmd_status ;;
  shell)     cmd_shell ;;
esac
