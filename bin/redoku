#!/bin/sh
# bin/redoku — get the rm2fb display server, the M4 decoy document + its
# watcher, and the reDoku game on and off a reMarkable 2 over SSH, without
# needing to understand the ssh/scp choreography.
#
# Works on Linux and macOS with the stock OpenSSH client. Run it from a
# reDoku checkout (it needs device/install.sh, device/uninstall.sh,
# device/redoku-watcher.service and tools/mkdecoy.rb).
#
# Safe by design:
#   * Your ~/.ssh/config is IGNORED by default (ssh -F /dev/null), so a
#     stray "Host *" rule can't break the connection — plain password
#     auth over the USB cable just works. Have keys or aliases set up?
#     Pass --ssh-config ~/.ssh/config.
#   * Host keys are pinned in ~/.ssh/redoku_known_hosts: the first
#     connection is trusted, a later mismatch fails loudly — and your
#     real known_hosts is never touched.
#   * Binaries are verified to be 32-bit ARM ELF before anything is
#     copied, every copy (the decoy's files and the watcher unit
#     included) is size-checked, and the on-device installer rolls the
#     device back to stock if anything fails.
#   * install and uninstall ask before touching the device (or pass --yes);
#     play does not, since its only write is one binary that play alone
#     refreshes on every run by design. --dry-run always shows the plan
#     without doing it, for every command.

set -eu

REPO=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)

# Which version am I, and am I a release build? A checkout stays "dev"
# forever; tools/mkkit.sh stamps this exact line to the real tag in every
# copy of this CLI it releases (design doc §3.3). That single rewrite is
# what lets a released CLI resolve and fetch its OWN tag with no separate
# lookup (§6.1) — and it must stay byte-for-byte "KIT_VERSION=dev" here,
# because mkkit.sh finds the line to rewrite by literal match, not a marker
# comment or a template placeholder.
KIT_VERSION=dev

REMOTE_DIR=/home/root/redoku
REMOTE_GAME=$REMOTE_DIR/bin/redoku    # the game binary on the device
KNOWN_HOSTS=$HOME/.ssh/redoku_known_hosts
CTL_PATH=$HOME/.ssh/redoku-ctl-%C

HOST=10.11.99.1
RUSER=root
SSH_CFG=            # empty = the safe default (-F /dev/null)
IDENTITY=
ARTIFACTS=
FORCE=0
PURGE=0
PLAY_SECS=          # empty = play interactively, until you stop it
PLAY_SECS_SET=0     # was --seconds given at all, distinct from its value
# Seconds a timed run's SIGTERM gets before the SIGKILL. Longer than the
# display connection's own 10 s receive timeout on purpose — see cmd_play.
KILL_GRACE=15
YES=0
DRY=0
CMD=

say()  { printf '==> %s\n' "$*"; }
die()  { printf 'ERROR: %s\n' "$*" >&2; exit 1; }

usage() {
  cat <<'EOF'
bin/redoku — put the rm2fb display server and the reDoku game on a reMarkable 2

usage:
  bin/redoku install      copy the built binaries to the device and install
                          (safe to re-run: idempotent from any state)
  bin/redoku play         run the game on the device
  bin/redoku uninstall    return the device to stock (safe, idempotent)
  bin/redoku status       show what's running on the device
  bin/redoku shell        open an SSH shell on the device

how it connects (the default just works):
  Plug the reMarkable in over USB and run a command. You'll be asked for
  the device's SSH password, shown on the device under
  Settings -> Help -> Copyrights and licenses. Your ~/.ssh/config is
  deliberately ignored so nothing in it can interfere. The connection is
  kept open for 2 minutes, so back-to-back commands ask only once.

playing the game:
  'install' stages the whole tree — the display server, a decoy "Sudoku"
  document it drops into the stock library, and the watcher that launches
  the game when you tap it — plus the game binary itself when it has been
  cross-built (it warns and installs everything else alone when it
  hasn't), and can be re-run at any time. 'play' then only refreshes that one
  binary (/home/root/redoku/bin/redoku, from the cross build in
  build/rm2/bin/ — run 'make build' first) and starts it, so working on the
  game never means restarting the display server or re-tapping the decoy.
  'uninstall' always takes the decoy and its watcher back out (the decoy
  can't outlive them — a document that launches nothing is worse than none);
  'uninstall --purge' also removes everything else.

options:
  -H, --host HOST         device address or ssh alias   (default: 10.11.99.1)
  -u, --user USER         ssh user                      (default: root)
  -F, --ssh-config FILE   use YOUR ssh config (aliases, keys, etc.) instead
                          of the safe default, e.g.:  -F ~/.ssh/config
  -i, --identity FILE     ssh private key to use
  -a, --artifacts DIR     where the built armv7 binaries are (install only;
                          default: build/rm2fb/dist/ — if empty, install
                          offers to build them with 'make rm2fb')
      --force             install: proceed on an untested firmware version
      --purge             uninstall: also delete /home/root/redoku
      --seconds N         play: stop the game after N seconds instead of
                          running it interactively (unattended smoke test)
  -y, --yes               don't ask for confirmation
  -n, --dry-run           show what would happen without touching anything
  -h, --help              this help

safety:
  The install only ADDs files (no kernel, boot, or partition changes),
  binaries are checked to really be 32-bit ARM before they leave your
  machine, and the on-device installer rolls back to stock on any
  failure. If the device ever seems stuck, hold the power button ~10 s:
  it reboots and a broken display server disarms itself.
EOF
}

# ---- argument parsing -------------------------------------------------

while [ $# -gt 0 ]; do
  case $1 in
    install|uninstall|play|status|shell)
      [ -z "$CMD" ] || die "two commands given: '$CMD' and '$1'"
      CMD=$1 ;;
    -H|--host)       [ $# -ge 2 ] || die "$1 needs a value"; HOST=$2; shift ;;
    -u|--user)       [ $# -ge 2 ] || die "$1 needs a value"; RUSER=$2; shift ;;
    -F|--ssh-config) [ $# -ge 2 ] || die "$1 needs a value"; SSH_CFG=$2; shift ;;
    -i|--identity)   [ $# -ge 2 ] || die "$1 needs a value"; IDENTITY=$2; shift ;;
    -a|--artifacts)  [ $# -ge 2 ] || die "$1 needs a value"; ARTIFACTS=$2; shift ;;
    --force)         FORCE=1 ;;
    --purge)         PURGE=1 ;;
    --seconds)       [ $# -ge 2 ] || die "$1 needs a value"; PLAY_SECS=$2; PLAY_SECS_SET=1; shift ;;
    -y|--yes)        YES=1 ;;
    -n|--dry-run)    DRY=1 ;;
    -h|--help)       usage; exit 0 ;;
    *)               die "unknown argument '$1' — see bin/redoku --help" ;;
  esac
  shift
done

[ -n "$CMD" ] || { usage; exit 1; }
command -v ssh >/dev/null 2>&1 || die "no 'ssh' on this machine"
[ -z "$SSH_CFG" ]  || [ -f "$SSH_CFG" ]  || die "ssh config not found: $SSH_CFG"
[ -z "$IDENTITY" ] || [ -f "$IDENTITY" ] || die "identity file not found: $IDENTITY"
[ -z "$ARTIFACTS" ] || [ -d "$ARTIFACTS" ] || die "artifacts directory not found: $ARTIFACTS"
[ "$FORCE" -eq 0 ] || [ "$CMD" = install ]   || die "--force only applies to install"
[ "$PURGE" -eq 0 ] || [ "$CMD" = uninstall ] || die "--purge only applies to uninstall"
[ -z "$ARTIFACTS" ] || [ "$CMD" = install ]  || die "--artifacts only applies to install"
[ "$PLAY_SECS_SET" -eq 0 ] || [ "$CMD" = play ] || die "--seconds only applies to play"
# It ends up as 'sleep N' on the device, which wants a plain whole number.
# Checked whenever --seconds was given at all (PLAY_SECS_SET), not just when
# its value happens to be non-empty — "--seconds ''" must not silently fall
# through to interactive play.
if [ "$PLAY_SECS_SET" -eq 1 ]; then
  # Three arms, first match wins, and the order is the whole point. Leading
  # zeros are REJECTED rather than stripped. Stripping them made the message
  # match the input ('000000' is zero seconds, and telling someone that is
  # more than 24 hours is worse than saying nothing) but it also carried
  # '086400' past the length arm below, which judges a number by how long it
  # is — widening what --seconds accepts, which was never the point.
  # Rejecting gets both: the message names the real complaint, and the range
  # stays 1..86400 however the number is spelled. Bare '0' is one character
  # short of that arm and falls through to "at least 1 second", which is
  # exactly what it is.
  case $PLAY_SECS in
    *[!0-9]* | '') die "--seconds wants whole seconds, not '$PLAY_SECS'" ;;
    0?*)           die "--seconds wants no leading zeros, not '$PLAY_SECS'" ;;
    ??????*)       die "--seconds wants at most 86400 seconds (24h), not '$PLAY_SECS'" ;;
  esac
  # At most five digits reach these, so neither can overflow the shell's own
  # integers and leak a raw diagnostic in place of a message.
  [ "$PLAY_SECS" -ge 1 ]     || die "--seconds wants at least 1 second"
  [ "$PLAY_SECS" -le 86400 ] || die "--seconds wants at most 86400 seconds (24h)"
fi

TARGET=$RUSER@$HOST

# ---- ssh plumbing -----------------------------------------------------

# One ssh invocation with the common options prepended. ControlMaster
# keeps the (password-authenticated) connection open and reuses it, so
# the password is asked at most once per 2 minutes.
ssh_run() {
  if [ -n "$IDENTITY" ]; then set -- -i "$IDENTITY" "$@"; fi
  if [ -n "$SSH_CFG" ]; then
    set -- -F "$SSH_CFG" "$@"
  else
    set -- -F /dev/null \
           -o UserKnownHostsFile="$KNOWN_HOSTS" \
           -o StrictHostKeyChecking=accept-new "$@"
  fi
  set -- -o ConnectTimeout=15 \
         -o ControlMaster=auto \
         -o ControlPath="$CTL_PATH" \
         -o ControlPersist=120 "$@"
  ssh "$@"
}

# Run one command on the device. Stdin/stdout pass through.
remote() {
  if [ "$DRY" -eq 1 ]; then
    printf '==> [dry-run] ssh %s -- %s\n' "$TARGET" "$1" >&2
    return 0
  fi
  ssh_run "$TARGET" "$1"
}

connect() {
  mkdir -p "$HOME/.ssh" && chmod 700 "$HOME/.ssh"
  if [ -n "$SSH_CFG" ]; then
    say "connecting to $TARGET (using your ssh config: $SSH_CFG)"
  else
    say "connecting to $TARGET — your ~/.ssh/config is intentionally ignored (see --help)"
    say "if asked for a password: it's shown on the device under"
    say "  Settings -> Help -> Copyrights and licenses"
  fi
  [ "$DRY" -eq 1 ] && return 0
  if remote true; then return 0; fi
  if [ -n "$SSH_CFG" ]; then
    die "could not connect to $TARGET
  - ssh config 'Host' blocks match the name you dial: if your config has
    the device under an alias, pass that alias too, e.g.:
      bin/redoku $CMD --ssh-config $SSH_CFG --host <alias>
  - Or drop --ssh-config to use plain password auth over USB."
  fi
  die "could not connect to $TARGET
  - Is the device plugged in via USB and awake? (tap the screen)
  - Did ssh report a host-key mismatch above? That happens after a device
    reset/reflash: delete $KNOWN_HOSTS and try again.
  - Password auth disabled on the device? Use your own setup with:
      --ssh-config ~/.ssh/config --host <alias>"
}

confirm() {
  [ "$YES" -eq 1 ] && return 0
  [ "$DRY" -eq 1 ] && return 0
  [ -t 0 ] || die "not running in a terminal — add --yes to skip confirmation"
  printf '%s [y/N] ' "$1"
  read -r _ans || die "aborted — nothing was touched"
  case $_ans in
    y|Y|yes|Yes|YES) ;;
    *) die "aborted — nothing was touched" ;;
  esac
}

# Stream a file to the device over the ssh connection (no scp: modern
# scp speaks SFTP, which the device's Dropbear may not) and verify the
# byte count on the other side. Unlink before writing: overwriting a
# RUNNING binary fails with ETXTBSY, and truncating a mapped .so can
# crash its user — a fresh inode has neither problem, so reinstalling
# over a live install just works.
push_file() { # push_file <local> <remote-path>
  # Belt and braces: every remote path is a hardcoded literal under
  # $REMOTE_DIR — refuse anything else so the rm -f below can never
  # reach outside the redoku directory.
  case $2 in
    "$REMOTE_DIR"/?*) ;;
    *) die "internal error: refusing to write outside $REMOTE_DIR: '$2'" ;;
  esac
  say "  sending $(basename "$1")"
  if [ "$DRY" -eq 1 ]; then
    printf '==> [dry-run] copy %s -> %s:%s\n' "$1" "$TARGET" "$2" >&2
    return 0
  fi
  remote "rm -f '$2' && cat > '$2'" < "$1"
  _lsize=$(wc -c < "$1" | tr -d '[:space:]')
  _rsize=$(remote "wc -c < '$2'" | tr -d '[:space:]')
  [ "$_lsize" = "$_rsize" ] || \
    die "copy of $1 arrived truncated ($_rsize of $_lsize bytes) — bad cable? try again"
}

# ---- finding + checking the built binaries ----------------------------

_hex_at() { dd if="$1" bs=1 skip="$2" count="$3" 2>/dev/null | od -An -tx1 | tr -d ' \n'; }

# 32-bit ARM ELF: magic 7f 'E' 'L' 'F' + ELFCLASS32, e_machine EM_ARM.
# Same check device/install.sh repeats on the device.
is_arm_elf() {
  [ "$(_hex_at "$1" 0 5)" = "7f454c4601" ] && [ "$(_hex_at "$1" 18 2)" = "2800" ]
}

# Print the unique 32-bit-ARM build of $2 under directory $1.
# Returns 1 when there is none, 2 when there are several.
pick_in() {
  [ -d "$1" ] || return 1
  _match=
  _count=0
  while IFS= read -r _f; do
    [ -n "$_f" ] || continue
    is_arm_elf "$_f" || continue
    _count=$((_count + 1))
    if [ "$_count" -eq 1 ]; then
      _match=$_f
    else
      [ "$_count" -eq 2 ] && \
        printf 'ERROR: several ARM builds of %s under %s:\n  %s\n' "$2" "$1" "$_match" >&2
      printf '  %s\n' "$_f" >&2
    fi
  done <<EOF
$(find "$1" -type f -name "$2" 2>/dev/null)
EOF
  if [ "$_count" -eq 0 ]; then return 1; fi
  if [ "$_count" -gt 1 ]; then
    printf 'pass the right one with:  --artifacts DIR\n' >&2
    return 2
  fi
  printf '%s\n' "$_match"
}

pick_artifact() { # $1 = filename; prints the path
  pick_in "${ARTIFACTS:-$REPO/build/rm2fb/dist}" "$1"
}

# The cross-built game, into $GAME. Its path is fixed (mruby's rake decides
# it), so there is nothing to search for and no --artifacts override; it is
# checked to really be 32-bit ARM like everything else that leaves this
# machine.
#
# Returns 1 with $GAME empty and $GAME_WHY explaining it, because the two
# callers want opposite things: 'install' installs the display server —
# which does not need the game and must stay installable on a fresh clone or
# while the game build is broken — so it warns and carries on, while 'play'
# has nothing to run and dies.
find_game() {
  GAME=$REPO/build/rm2/bin/redoku
  GAME_WHY=
  # In a checkout (KIT_VERSION=dev) a missing or wrong-arch game means a
  # build step was never run, so the hint names the build. Inside a
  # released kit (KIT_VERSION stamped) there is no build to run — this
  # exact file shipped prebuilt (design doc §3.2) — so the SAME two
  # conditions instead mean the download is incomplete or corrupt, and the
  # fix is to re-fetch it, which is what "redoku upgrade" does (added in a
  # later task of this milestone; naming it here is still correct).
  if [ ! -f "$GAME" ]; then
    if [ "$KIT_VERSION" = dev ]; then
      GAME_WHY="no game binary at $GAME — cross-build it with:  make build"
    else
      GAME_WHY="no game binary at $GAME — this kit is incomplete or corrupt, re-download it with:  redoku upgrade"
    fi
  elif ! is_arm_elf "$GAME"; then
    # One line, like the message above it: both callers print it as a single
    # indented continuation line, where an embedded newline would lose its
    # prefix and its indentation.
    if [ "$KIT_VERSION" = dev ]; then
      GAME_WHY="$GAME is not 32-bit ARM (a host build?) — rebuild with:  make clean && make build"
    else
      GAME_WHY="$GAME is not 32-bit ARM — this kit is corrupt, re-download it with:  redoku upgrade"
    fi
  fi
  [ -z "$GAME_WHY" ] || { GAME=; return 1; }
}

# ---- the decoy document (M4) --------------------------------------------

# Builds fresh decoy files into $DECOY_DIR via tools/mkdecoy.rb (host-side
# CRuby, stdlib only — no gems, no bundler) and sets DECOY_FILES to the
# four sidecar files it wrote. Its uuid never becomes a shell variable
# here: DECOY_FILES is discovered from what the tool actually produced,
# the same "get it from the tool instead of hardcoding a second copy of
# the constant" reasoning device/install.sh's header gives for reading it
# back out of watch.conf on the device side.
#
# Always runs, --dry-run included: unlike 'make rm2fb' below (a slow
# Docker cross-compile this function deliberately does NOT touch), this
# is a fast, local, read-only-to-the-device operation, and the dry-run
# plan needs its real output — real filenames — to say anything concrete.
build_decoy() {
  DECOY_DIR=$REPO/build/decoy
  command -v ruby >/dev/null 2>&1 || \
    die "no 'ruby' on this machine — tools/mkdecoy.rb needs a stdlib-only
  CRuby (no gems, no bundler) to build the decoy document. Install one
  (your OS package manager or a version manager both work) and try again."
  say "building the decoy document (tools/mkdecoy.rb)"
  ruby "$REPO/tools/mkdecoy.rb" --out "$DECOY_DIR" >/dev/null || \
    die "tools/mkdecoy.rb failed — re-run it directly for the full error:
    ruby $REPO/tools/mkdecoy.rb --out $DECOY_DIR"
  DECOY_FILES=$(find "$DECOY_DIR" -maxdepth 1 -type f \
    \( -name '*.pdf' -o -name '*.metadata' -o -name '*.content' -o -name '*.pagedata' \) \
    2>/dev/null | sort)
  [ -n "$DECOY_FILES" ] || \
    die "tools/mkdecoy.rb ran but $DECOY_DIR has none of the expected decoy files"
  [ -f "$DECOY_DIR/watch.conf" ] || \
    die "tools/mkdecoy.rb ran but didn't write $DECOY_DIR/watch.conf"
}

# ---- commands ----------------------------------------------------------

cmd_install() {
  [ -f "$REPO/device/install.sh" ] && [ -f "$REPO/device/uninstall.sh" ] && \
    [ -f "$REPO/device/redoku-watcher.service" ] || \
    die "device/install.sh (or uninstall.sh, or redoku-watcher.service) not found next to me — run bin/redoku from a reDoku checkout"

  build_decoy

  # Before the server hunt below, which may offer a long 'make rm2fb', so
  # that the plan can report the game's state without a wait in between.
  find_game || true

  say "looking for the built armv7 binaries in ${ARTIFACTS:-build/rm2fb/dist}"
  SERVER=$(pick_artifact rm2fb_server_swtcon) || SERVER=
  CLIENT=$(pick_artifact librm2fb_client_swtcon.so) || CLIENT=
  if [ -z "$SERVER" ] || [ -z "$CLIENT" ]; then
    [ -z "$ARTIFACTS" ] || \
      die "no ARM builds of rm2fb_server_swtcon / librm2fb_client_swtcon.so under $ARTIFACTS"
    say "not built yet — 'make rm2fb' cross-compiles them in Docker"
    say "  (first run clones the pinned rM2-stuff into tmp/ and can take a while)"
    confirm "Run 'make rm2fb' now?"
    [ "$DRY" -eq 0 ] || die "dry-run: would run 'make rm2fb' — run that first, then retry"
    command -v docker >/dev/null 2>&1 || \
      die "docker not found — 'make rm2fb' needs it (see README prerequisites)"
    make -C "$REPO" rm2fb || die "'make rm2fb' failed (its output above says why)"
    SERVER=$(pick_artifact rm2fb_server_swtcon) || \
      die "build finished but rm2fb_server_swtcon is not in build/rm2fb/dist"
    CLIENT=$(pick_artifact librm2fb_client_swtcon.so) || \
      die "build finished but librm2fb_client_swtcon.so is not in build/rm2fb/dist"
  fi
  CTLBIN=$(pick_artifact rm2fbctl) || CTLBIN=

  say "this will:"
  say "  device : $TARGET"
  say "  server : $SERVER"
  say "  client : $CLIENT"
  if [ -n "$CTLBIN" ]; then
    say "  ctl    : $CTLBIN"
  else
    say "  ctl    : rm2fbctl not found — optional, continuing without it"
  fi
  if [ -n "$GAME" ]; then
    say "  game   : $GAME"
  else
    say "  game   : WARNING — skipped, everything else goes on alone:"
    say "           $GAME_WHY"
    say "           then re-run 'bin/redoku install' to stage the game"
  fi
  say "  decoy  : $DECOY_DIR (regenerated by tools/mkdecoy.rb, same uuid every run)"
  say "  watcher: $REPO/device/redoku-watcher.service"
  say "  action : copy to $REMOTE_DIR/ and run the on-device installer"
  say "           (adds files only; any failure rolls back to stock)"
  say "  re-run : safe any time — the same files, the same end state"
  confirm "Install on the device?"

  connect
  say "copying files to $REMOTE_DIR"
  remote "mkdir -p $REMOTE_DIR/bin $REMOTE_DIR/lib $REMOTE_DIR/decoy"
  push_file "$SERVER" "$REMOTE_DIR/bin/rm2fb_server_swtcon"
  push_file "$CLIENT" "$REMOTE_DIR/lib/librm2fb_client_swtcon.so"
  [ -z "$CTLBIN" ] || push_file "$CTLBIN" "$REMOTE_DIR/bin/rm2fbctl"
  [ -z "$GAME" ] || push_file "$GAME" "$REMOTE_GAME"
  push_file "$REPO/device/install.sh" "$REMOTE_DIR/install.sh"
  push_file "$REPO/device/uninstall.sh" "$REMOTE_DIR/uninstall.sh"
  push_file "$REPO/device/redoku-watcher.service" "$REMOTE_DIR/redoku-watcher.service"
  # watch.conf goes straight to its final home (device/install.sh reads it
  # there, and the running watcher does too — both by fixed, undisputed
  # path, not a staged copy an install step has to relocate).
  push_file "$DECOY_DIR/watch.conf" "$REMOTE_DIR/watch.conf"
  # The four sidecar files stay staged under $REMOTE_DIR/decoy/: their
  # real home is xochitl's own document store, which is outside
  # $REMOTE_DIR and therefore outside push_file's guard (on purpose — see
  # push_file's header) — device/install.sh, running as root, is what
  # copies them the rest of the way in and creates the <uuid>/ ink dir.
  for f in $DECOY_FILES; do
    push_file "$f" "$REMOTE_DIR/decoy/$(basename "$f")"
  done
  remote "chmod +x $REMOTE_DIR/bin/"'*'

  _force_arg=
  [ "$FORCE" -eq 0 ] || _force_arg=' --force'
  say "running the on-device installer (~30 s, includes a 15 s verification wait)"
  if remote "sh $REMOTE_DIR/install.sh$_force_arg"; then
    # remote() returns 0 unconditionally in dry-run, so without this guard
    # a dry run would print an outcome it never actually got.
    if [ "$DRY" -eq 1 ]; then
      say "[dry-run] stops here — nothing above actually ran"
    else
      say "all done — xochitl is running through the display server, decoy in the library"
      if [ -n "$GAME" ]; then
        say "  play it    : tap 'Sudoku' in the library, or bin/redoku play"
      else
        say "  play it    : make build, then bin/redoku play (tapping the decoy needs the game staged too)"
      fi
      say "  check it   : bin/redoku status"
      say "  banished it: bin/redoku uninstall"
    fi
  else
    die "the on-device installer failed and rolled the device back to stock
  (its output above says why; the device is safe and unchanged)"
  fi
}

cmd_play() {
  find_game || die "$GAME_WHY"
  connect

  # Just the game binary. 'install' stages the whole tree; re-running it here
  # would restart the display server and xochitl for a file neither of them
  # reads. One binary is all that changes while you work on the game, and
  # push_file unlinks before writing, so refreshing it while an older
  # instance is still running is safe.
  say "refreshing $REMOTE_GAME"
  remote "mkdir -p $REMOTE_DIR/bin"
  push_file "$GAME" "$REMOTE_GAME"
  remote "chmod +x $REMOTE_GAME"

  # The game cannot paint a single pixel without the server, so say so here
  # rather than let it fail with a socket error on the device.
  if [ "$DRY" -eq 0 ] && [ "$(remote \
       'systemctl is-active rm2fb.service 2>/dev/null || true' \
       | tr -d '[:space:]')" != active ]; then
    say "WARNING: rm2fb.service is not active — the game cannot draw."
    say "         Install the display server first:  bin/redoku install"
  fi

  if [ -z "$PLAY_SECS" ]; then
    say "starting the game — the Quit button (or Ctrl-C) gives the screen back"
    if [ "$DRY" -eq 1 ]; then
      printf '==> [dry-run] ssh -t %s -- %s\n' "$TARGET" "$REMOTE_GAME" >&2
      return 0
    fi
    # -t asks for a real tty so Ctrl-C arrives as SIGINT at the game, which
    # quits cleanly, instead of just dropping the ssh session behind its back.
    _rc=0
    ssh_run -t "$TARGET" "$REMOTE_GAME" || _rc=$?
    [ "$_rc" -eq 0 ] || die "the game exited $_rc — its output above says why"
    say "done — the screen is back to xochitl"
    return 0
  fi

  # No tty this time: nothing is watching. No 'timeout' either — the device's
  # BusyBox has no such applet — so a background sleep TERMs the game and
  # 'wait' reports how it went. 143 is 128+SIGTERM, meaning the signal killed
  # it outright; redoku handles SIGTERM and exits 0 instead, so a timed run
  # ending either way is a run that ended when we asked it to.
  #
  # SIGCONT follows the TERM, and a SIGKILL follows both $KILL_GRACE seconds
  # later, because a signal sent to a STOPPED process just sits there
  # pending: the display server stops a client it demotes, and such a game
  # never runs to handle its SIGTERM at all, so the deadline this option
  # promises was not a deadline. CONT lets it wake up and quit cleanly
  # (giving the panel back on its own terms); KILL is the guarantee, needs no
  # CONT of its own — a stopped process dies of it regardless — and surfaces
  # as exit 137, which the case below reports for what it is.
  #
  # The grace has to outlast the display connection's own receive timeout,
  # not just a scheduler hiccup: RM2_RECV_TIMEOUT_SEC is 10 s
  # (mrbgems/mruby-rm2/src/display.c), so a game blocked in a read against a
  # server that has stopped acking cannot even look at its SIGTERM until that
  # expires. At 5 s the KILL landed first and the 137 message described
  # something that had not happened — an ignored signal or a stopped process —
  # when the truth was a socket read that would have returned. 15 s is that
  # timeout plus slack; the common case sits in poll(), which returns on
  # EINTR, and exits 0 well inside a second either way.
  #
  # The watchdog's >/dev/null 2>&1 is what makes an early death report early.
  # 'kill $sp' kills the subshell, not the sleep it forked, and an orphaned
  # sleep holding the remote stdout keeps the ssh channel from reaching EOF —
  # so a game that dies in 0.2 s would not be reported for the full N
  # seconds. With its own stdio detached, the orphan holds nothing. (BusyBox
  # 1.36 runs 'sleep' in-process and so dies with the subshell, hiding this;
  # dash and friends leave the orphan, and the device's applet set is a
  # build-time choice we should not lean on.)
  #
  # Ctrl-C here kills ssh, not the game: the watchdog is deliberately left
  # alive so it still TERMs the game at second N, but the panel stays taken
  # until then.
  #
  # 'setsid' is what keeps the watchdog out of the game's process group, and
  # it is load-bearing: the display server pauses a client it demotes with
  # kill(-getpgid(pid), SIGSTOP) — the WHOLE group. In a non-interactive
  # 'sh -c' job control is off, so without it the game, the watchdog subshell
  # and the waiting shell all share the group sshd made, and anything taking
  # front during the window (xochitl restarting, another rm2fb client, a
  # stray 'rm2fbctl switch') freezes the watchdog along with the game: N
  # seconds becomes unbounded, ssh never sees EOF, and the panel stays taken.
  # In its own session the watchdog cannot be stopped by the game's demotion.
  #
  # $! is still the game: setsid() only fails for a process-group leader, and
  # a background child of this shell is not one, so setsid execs in place
  # rather than forking. This is not the setsid PLAN.md §5 refuses — that one
  # is about the game keeping its controlling terminal so Ctrl-C reaches it
  # as SIGINT, which is the interactive path above; this path has no tty at
  # all.
  say "running the game for ${PLAY_SECS}s, unattended"
  _watchdog="sleep $PLAY_SECS; kill -TERM \$rp 2>/dev/null; kill -CONT \$rp 2>/dev/null; sleep $KILL_GRACE; kill -KILL \$rp 2>/dev/null"
  _timed="setsid $REMOTE_GAME & rp=\$!; ($_watchdog) >/dev/null 2>&1 & sp=\$!; wait \$rp; rc=\$?; kill \$sp 2>/dev/null; exit \$rc"
  _rc=0
  remote "$_timed" || _rc=$?
  # remote() returns 0 unconditionally in dry-run, so without this the case
  # below would announce an outcome from a run that never happened — the trap
  # wave B fixed for 'install', in the one other place that had it.
  if [ "$DRY" -eq 1 ]; then
    say "[dry-run] stops here — nothing above actually ran"
    return 0
  fi
  case $_rc in
    0|143) say "the timed run ended cleanly (exit $_rc)" ;;
    137)   die "the game was SIGKILLed (exit 137)
  It did not stop for SIGTERM within ${KILL_GRACE}s of the ${PLAY_SECS}s deadline — it
  was ignoring the signal, the display server had it stopped and even SIGCONT
  did not get it to quit, or it was stuck in a display read for longer than the
  connection's own 10 s receive timeout. The panel is back either way;
  'bin/redoku status' says what is running now." ;;
    *)     die "the game exited $_rc — its output above says why" ;;
  esac
}

cmd_uninstall() {
  [ -f "$REPO/device/uninstall.sh" ] || \
    die "device/uninstall.sh not found next to me — run bin/redoku from a reDoku checkout"

  say "this returns the device to stock (idempotent, safe on partial installs)"
  say "  the decoy 'Sudoku' document and its watcher always come out —"
  say "  a document that launches nothing is worse than no document at all"
  if [ "$PURGE" -eq 1 ]; then
    say "  --purge: ALSO deletes $REMOTE_DIR entirely (binaries, scripts, everything)"
  fi
  confirm "Return the device to stock?"

  connect
  say "copying the uninstaller"
  remote "mkdir -p $REMOTE_DIR"
  push_file "$REPO/device/uninstall.sh" "$REMOTE_DIR/uninstall.sh"

  _purge_arg=
  [ "$PURGE" -eq 0 ] || _purge_arg=' --purge'
  say "running the on-device uninstaller"
  remote "sh $REMOTE_DIR/uninstall.sh$_purge_arg"
  say "done — the device is back to stock"
}

cmd_status() {
  connect
  remote 'printf "firmware : %s\n" "$(sed -n "s/^IMG_VERSION=//p" /etc/os-release | tr -d \")"
if [ -f /etc/systemd/system/rm2fb.service ]; then printf "installed: yes\n"; else printf "installed: no\n"; fi
printf "rm2fb    : %s\n" "$(systemctl is-active rm2fb.service 2>/dev/null || true)"
printf "xochitl  : %s\n" "$(systemctl is-active xochitl.service 2>/dev/null || true)"
if [ -S /var/run/rm2fb.sock ]; then printf "socket   : present\n"; else printf "socket   : absent\n"; fi
if [ -f /home/root/redoku/preload.env ]; then printf "preload  : armed (xochitl draws through rm2fb)\n"; else printf "preload  : disarmed (xochitl is stock)\n"; fi'
}

cmd_shell() {
  connect
  [ "$DRY" -eq 1 ] && return 0
  ssh_run "$TARGET"
}

case $CMD in
  install)   cmd_install ;;
  play)      cmd_play ;;
  uninstall) cmd_uninstall ;;
  status)    cmd_status ;;
  shell)     cmd_shell ;;
esac
